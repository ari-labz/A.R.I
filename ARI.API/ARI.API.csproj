<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ARI.LLM\ARI.LLM.csproj" />
    <ProjectReference Include="..\ARI.VoiceSynthesis\ARI.VoiceSynthesis.csproj" />
    <ProjectReference Include="..\ARI.Voice\ARI.Voice.csproj" />
    <ProjectReference Include="..\ARI.Common\ARI.Common.csproj" />
    <ProjectReference Include="..\ARI.Listener\ARI.Listener.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="10.0.8" />
  </ItemGroup>

  <Target Name="BuildAriUi" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <AriUiDir>$(MSBuildProjectDirectory)\..\ARI.UI</AriUiDir>
      <BunExe Condition="'$(OS)' == 'Unix'">$(HOME)/.bun/bin/bun</BunExe>
      <BunExe Condition="'$(OS)' != 'Unix'">$(USERPROFILE)\.bun\bin\bun.exe</BunExe>
    </PropertyGroup>
    <Message Importance="high" Text="Building ARI.UI via $(BunExe) run build" />
    <Exec Command="&quot;$(BunExe)&quot; run build" WorkingDirectory="$(AriUiDir)" />
  </Target>

</Project>

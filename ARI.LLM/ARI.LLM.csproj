<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ARI.Brain\ARI.Brain.csproj" />
    <ProjectReference Include="..\ARI.Common\ARI.Common.csproj" />
    <ProjectReference Include="..\ARI.Sdk\ARI.Sdk.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- The API layer hosts the client (WebSocket) FileSystem backend, which subclasses the internal
       ARI.LLM.FileSystem. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ARI.API" />
    <InternalsVisibleTo Include="ARI.Plugin.GitHub" />
    <InternalsVisibleTo Include="ARI.Plugin.Discord" />
  </ItemGroup>
  <!-- The scripts ARI ships are C# text compiled at run time, not part of this assembly. -->
  <ItemGroup>
    <Compile Remove="Scripts/SystemScripts/**" />
    <EmbeddedResource Include="Scripts/SystemScripts/**/*.cs" />
  </ItemGroup>
  <!-- The built-in tools' own source, shipped as text so the control panel's Tools tab can show it as a reference. -->
  <ItemGroup>
    <EmbeddedResource Include="Scripts/Tools/**/*.cs" LogicalName="ToolSource/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.11.71" />
    <!-- Reads PDFs (text and layout), pure managed code. -->
    <PackageReference Include="PdfPig" Version="0.1.10" />
    <!-- Reads and writes Excel workbooks; brings the Open XML SDK, which also reads Word and PowerPoint files. -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <!-- Drives a headless Chrome/Chromium so Ari can open, read, click and screenshot web pages. -->
    <PackageReference Include="PuppeteerSharp" Version="25.15.0" />
    <!-- Compiles the C# scripts people write for pipeline nodes and tools, while A·R·I is running. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <ProjectReference Include="..\Submodules\SmartReader\src\SmartReader\SmartReader.csproj" />
  </ItemGroup>

</Project>

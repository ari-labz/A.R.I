<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-ARI.Core-f9caf1c1-b2ea-4e29-bcc9-19eb3eb245aa</UserSecretsId>
    <!-- Referenced projects each ship a default appsettings.json; on publish they collide at the
         same output path (NETSDK1152). They're unused template defaults (config is AriConfig.json),
         so let publish resolve the duplicates instead of failing. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <!--
    APP_INSTALL_ROOT: where the build lands — contains only build output, no user data (that's
    AppDataRoot, see ARI.Common/Scripts/AriPaths.cs). Env var wins; otherwise the OS default
    install location. Stands in for a real installer until one exists.
  -->
  <PropertyGroup>
    <AppInstallRoot Condition="'$(AppInstallRoot)' == '' AND '$(APP_INSTALL_ROOT)' != ''">$(APP_INSTALL_ROOT)</AppInstallRoot>
    <!-- Dev builds (Rider / `dotnet build` with no APP_INSTALL_ROOT) land in the repo's devbuild/
         folder. /Applications and %ProgramFiles% are reserved for real installs done by the installer. -->
    <AppInstallRoot Condition="'$(AppInstallRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\devbuild'))</AppInstallRoot>
    <OutputPath>$(AppInstallRoot)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!-- Build the React UI and sync it into wwwroot before compiling -->
  <Target Name="BuildUI" BeforeTargets="Build">
    <PropertyGroup>
      <UiDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\ARI.UI'))</UiDir>
      <WwwrootDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\ARI.API\wwwroot'))</WwwrootDir>
    </PropertyGroup>
    <Exec Command="&quot;$(UserProfile)/.bun/bin/bun&quot; run build" WorkingDirectory="$(UiDir)" Condition="'$(OS)' == 'Windows_NT'" />
    <Exec Command="&quot;$(HOME)/.bun/bin/bun&quot; run build" WorkingDirectory="$(UiDir)" Condition="'$(OS)' != 'Windows_NT'" />
    <ItemGroup>
      <UiDistFiles Include="$(UiDir)\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(UiDistFiles)" DestinationFiles="@(UiDistFiles->'$(WwwrootDir)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Text="UI built and synced to wwwroot" Importance="high" />
  </Target>

  <ItemGroup>
	<Content Update="Agents.json">
		<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</Content>
	<Content Update="Servers.json">
		<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</Content>
	<Content Update="Models.json">
		<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</Content>
	<Content Update="AriConfig.json">
		<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</Content>
	<!-- Repo-root manifest: server version + protocol. Shipped so the server can read its own
	     version (UpdateCheck) and so the release carries it for the installer. -->
	<Content Include="..\manifest.json">
		<Link>manifest.json</Link>
		<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</Content>
  	<Content Include="..\ARI.API\wwwroot\**\*">
  		<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  		<LinkBase>wwwroot</LinkBase>
  	</Content>
  	<Content Update="..\ARI.API\wwwroot\images\Black Code .png">
  	  <Link>wwwroot\images\Black Code .png</Link>
  	</Content>
  	<!-- StyleTTS2 source ships with the install (repo-relative wins during dev — see
  	     AriPaths.ResolveInstallAsset in ARI.cs). venv/Models/per-model training dirs are AppData-based
  	     mutable state (StyleTtsTrainer/StyleTtsSetupService — see VoiceSynthesisConfig.DataDir) and
  	     never live here; Data/Data is a stray leftover nested duplicate, not shipped either.
  	     What DOES ship from Data/: the shared scaffold (OOD_texts.txt, Dummy/, train_list.txt,
  	     val_list.txt) that Utils-relative training config paths need at the StyleTTS2 source root. -->
  	<Content Include="..\External\StyleTTS2\**\*"
  	         Exclude="..\External\StyleTTS2\venv\**;..\External\StyleTTS2\Data\Data\**;..\External\StyleTTS2\Models\**;..\External\StyleTTS2\__pycache__\**">
  	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  	  <LinkBase>External\StyleTTS2</LinkBase>
  	</Content>
  	<!-- Listener's whisper-server script; its venv is gitignored/generated and never copied. -->
  	<Content Include="..\ARI.Listener\python\whisper_serve.py;..\ARI.Listener\python\requirements.txt">
  	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  	  <LinkBase>Listener</LinkBase>
  	</Content>
  </ItemGroup>
	
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="Serilog.Expressions" Version="5.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>
	
  <ItemGroup>
    <ProjectReference Include="..\ARI.Brain\ARI.Brain.csproj" />
    <ProjectReference Include="..\ARI.Discord\ARI.Discord.csproj" />
    <ProjectReference Include="..\ARI.LLM\ARI.LLM.csproj" />
    <ProjectReference Include="..\ARI.API\ARI.API.csproj" />
    <ProjectReference Include="..\ARI.VoiceSynthesis\ARI.VoiceSynthesis.csproj" />
    <ProjectReference Include="..\ARI.Voice\ARI.Voice.csproj" />
    <ProjectReference Include="..\ARI.Common\ARI.Common.csproj" />
    <ProjectReference Include="..\ARI.Listener\ARI.Listener.csproj" />
    <ProjectReference Include="..\ARI.Scheduler\ARI.Scheduler.csproj" />
  </ItemGroup>

</Project>

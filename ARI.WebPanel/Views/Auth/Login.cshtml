@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>A·R·I — Sign In</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg:       #223742;
            --card-bg:  #1a2c35;
            --border:   #16262E;
            --text:     #c8d8df;
            --dim:      #7a9aaa;
            --accent:   #c8d8df;
        }

        html, body {
            height: 100%;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
            background: var(--bg);
            color: var(--text);
            display: flex;
            align-items: center;
            justify-content: center;
            -webkit-font-smoothing: antialiased;
        }

        .card {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 32px;
            padding: 52px 48px;
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 20px;
            width: 100%;
            max-width: 380px;
        }

        .wordmark {
            font-size: 28px;
            font-weight: 700;
            letter-spacing: .08em;
            color: #fff;
        }

        .tagline {
            font-size: 14px;
            color: var(--dim);
            text-align: center;
            line-height: 1.5;
            margin-top: -20px;
        }

        .btn-google {
            display: flex;
            align-items: center;
            gap: 12px;
            width: 100%;
            padding: 13px 20px;
            background: #fff;
            color: #1a1a1a;
            border: none;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 500;
            font-family: inherit;
            cursor: pointer;
            text-decoration: none;
            transition: background .15s, box-shadow .15s;
            box-shadow: 0 1px 3px rgba(0,0,0,.3);
            justify-content: center;
        }

        .btn-google:hover {
            background: #f5f5f5;
            box-shadow: 0 2px 8px rgba(0,0,0,.4);
        }

        .btn-google svg {
            flex-shrink: 0;
        }

        .footer {
            font-size: 12px;
            color: var(--dim);
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="card">
        <div class="wordmark">A·R·I</div>
        <p class="tagline">Artificial Reasoning Intelligence<br/>Private access only</p>

        @if (Context.Request.Query["error"] == "unauthorized")
        {
            <p style="color:#f87171;font-size:13px;text-align:center;background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.25);border-radius:8px;padding:10px 14px;">
                That Google account is not authorised to access A·R·I.
            </p>
        }

        <a href="/auth/login" class="btn-google">
            <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
                <path d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.875 2.684-6.615z" fill="#4285F4"/>
                <path d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z" fill="#34A853"/>
                <path d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332z" fill="#FBBC05"/>
                <path d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 6.29C4.672 4.163 6.656 3.58 9 3.58z" fill="#EA4335"/>
            </svg>
            Continue with Google
        </a>

        <p class="footer">Access is restricted to authorised users only.</p>
    </div>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — A·R·I</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="A·R·I" />
    <meta name="theme-color" content="#223742" />
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
    --sidebar-bg:   #223742;
    --sidebar-border: #16262E;
    --sidebar-hover: rgba(255,255,255,.07);
    --sidebar-active: rgba(255,255,255,.13);
    --sidebar-text: #c8d8df;
    --sidebar-dim:  #7a9aaa;
    --main-bg:      #ffffff;
    --text:         #1a1a1a;
    --text-dim:     #6b7280;
    --border:       #e5e7eb;
    --user-bubble:  #f3f4f6;
    --input-bg:     #ffffff;
    --input-border: #d1d5db;
    --input-focus:  #9ca3af;
    --accent:       #223742;
    --accent-hover: #16262E;
    --col-max:      680px;
    --sidebar-w:    240px;
}

html, body {
    height: 100%;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    background: var(--main-bg);
    color: var(--text);
    font-size: 15px;
    overflow: hidden;
    -webkit-font-smoothing: antialiased;
}

/* ── shell ───────────────────────────────────────────── */
#shell { display: flex; height: 100dvh; overflow: hidden; }

/* ── sidebar ─────────────────────────────────────────── */
#sidebar {
    width: var(--sidebar-w);
    min-width: var(--sidebar-w);
    background: var(--sidebar-bg);
    border-right: 1px solid var(--sidebar-border);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: width .2s ease, min-width .2s ease;
    flex-shrink: 0;
}
#sidebar.collapsed { width: 0; min-width: 0; border-right: none; }
#sidebar-inner { width: var(--sidebar-w); display: flex; flex-direction: column; height: 100%; overflow: hidden; }

#sidebar-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 14px 12px;
}

#sidebar-wordmark {
    width: 100px;
    height: auto;
    display: block;
    flex-shrink: 0;
}

#btn-toggle-sidebar {
    background: none; border: none; cursor: pointer;
    color: var(--sidebar-dim); padding: 4px; border-radius: 6px;
    display: flex; align-items: center;
    transition: color .12s, background .12s;
}
#btn-toggle-sidebar:hover { color: #fff; background: var(--sidebar-hover); }

#btn-new-chat {
    margin: 0 10px 14px;
    display: flex; align-items: center; gap: 9px;
    padding: 9px 12px;
    border: 1px solid rgba(255,255,255,.15);
    background: none; color: var(--sidebar-text);
    cursor: pointer; border-radius: 8px;
    font-size: 14px; font-family: inherit;
    transition: background .12s, border-color .12s;
    width: calc(100% - 20px); text-align: left;
}
#btn-new-chat:hover { background: var(--sidebar-hover); border-color: rgba(255,255,255,.25); }

#sidebar-section-label {
    font-size: 11px; font-weight: 600; letter-spacing: .07em;
    text-transform: uppercase; color: var(--sidebar-dim);
    padding: 0 16px 6px;
}

#thread-list {
    list-style: none; overflow-y: auto; flex: 1;
    padding: 0 8px 16px;
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,.1) transparent;
}

#thread-list li {
    padding: 9px 12px; border-radius: 7px;
    cursor: pointer; font-size: 14px; color: var(--sidebar-text);
    overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
    transition: background .1s;
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
}
#thread-list li:hover  { background: var(--sidebar-hover); }
#thread-list li.active { background: var(--sidebar-active); color: #fff; }

.thread-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
.thread-time { font-size: 11px; color: var(--sidebar-dim); flex-shrink: 0; }

/* ── main ────────────────────────────────────────────── */
#main {
    flex: 1; display: flex; flex-direction: column;
    overflow: hidden; background: var(--main-bg); position: relative;
}

#chat-col {
    flex: 1; display: flex; flex-direction: column;
    overflow: hidden; min-width: 0;
}

/* messages + thread panel share this zone — collapses in idle like #messages used to */
#messages-wrap {
    flex: 1; position: relative; overflow: hidden;
    display: flex; flex-direction: column;
    max-height: 0;
    transition: max-height 0.65s ease-in-out;
}
#main.active #messages-wrap {
    max-height: 100dvh;
}

/* ── drop overlay ───────────────────────────────────── */
#drop-overlay {
    position: absolute; inset: 10px; border-radius: 18px;
    z-index: 300; pointer-events: none;
    background: rgba(142, 192, 205, 0.30);
    border: 2px dashed rgba(60, 122, 137, 0.55);
    display: none;
    align-items: center; justify-content: center;
    flex-direction: column; gap: 10px;
}
#drop-overlay-inner {
    display: flex; flex-direction: column; align-items: center; gap: 10px;
}
#drop-overlay-title {
    margin: 0; font-size: 18px; font-weight: 650; letter-spacing: -.01em;
    color: #3c7a89;
}
#drop-overlay-sub {
    margin: 0; font-size: 13px; color: rgba(60, 122, 137, 0.75);
}
#drop-overlay svg { color: #3c7a89; }

/* ── thread panel toggle button ──────────────────────── */
#btn-open-thread-panel {
    position: absolute; top: 14px; right: 14px; z-index: 10;
    background: none; border: none; cursor: pointer;
    color: var(--text-dim); padding: 5px; border-radius: 7px;
    display: none; align-items: center;
    transition: color .12s, background .12s;
}
#btn-open-thread-panel:hover { color: var(--text); background: var(--user-bubble); }
#main.active #btn-open-thread-panel { display: flex; }
#btn-open-thread-panel.hidden { display: none !important; }

/* ── thread panel (anchored to messages-wrap) ────────── */
#thread-panel {
    position: absolute; top: 12px; right: 0; bottom: 28px;
    width: 220px;
    display: flex; flex-direction: column;
    background: #518c9a;
    border-left: 1px solid rgba(255,255,255,.15);
    border-radius: 14px 0 0 14px;
    box-shadow: -4px 0 24px rgba(0,0,0,.35);
    overflow: hidden; z-index: 100;
    padding: 8px 0;
    transform: translateX(calc(100% + 4px));
    transition: transform .3s ease-in-out;
    pointer-events: none;
}
#thread-panel.open {
    transform: translateX(0);
    pointer-events: auto;
}
#thread-panel-inner { display: flex; flex-direction: column; overflow-y: auto; flex: 1; }

#thread-panel-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 14px 10px;
    font-size: 13px; font-weight: 600; color: #fff;
    border-bottom: 1px solid rgba(255,255,255,.2);
    flex-shrink: 0;
}
#btn-close-thread-panel {
    background: transparent; border: none; cursor: pointer;
    color: rgba(255,255,255,.6); padding: 2px;
    display: flex; align-items: center; transition: color .15s;
}
#btn-close-thread-panel:hover { color: #fff; }
#thread-panel-actions {
    padding: 8px 14px 10px;
    border-bottom: 1px solid rgba(255,255,255,.1);
    display: flex; gap: 4px;
}
#btn-download-log {
    background: transparent; border: none; cursor: pointer;
    color: rgba(255,255,255,.5); padding: 4px; border-radius: 6px;
    display: flex; align-items: center; transition: color .12s, background .12s;
}
#btn-download-log:hover { color: #fff; background: rgba(255,255,255,.08); }

.thread-panel-section { padding: 10px 14px 14px; }
.thread-panel-section-label {
    font-size: 11px; font-weight: 600; color: rgba(255,255,255,.65);
    text-transform: uppercase; letter-spacing: .06em;
    margin-bottom: 8px;
    display: flex; align-items: center; justify-content: space-between;
}
.thread-panel-section-label button {
    background: transparent; border: none; cursor: pointer;
    color: rgba(255,255,255,.65); padding: 2px;
    display: flex; align-items: center; transition: color .15s;
}
.thread-panel-section-label button:hover { color: #fff; }

#attachment-list {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: 4px;
}
#attachment-list li {
    display: flex; align-items: center; gap: 6px;
    font-size: 12.5px; color: #fff;
    border-radius: 6px; padding: 5px 6px;
    background: rgba(255,255,255,.12);
}
#attachment-list li.attachment-empty {
    color: rgba(255,255,255,.55); font-size: 12px; background: transparent;
}
.attachment-item-name {
    flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.attachment-item-remove {
    flex-shrink: 0; background: transparent; border: none;
    color: rgba(255,255,255,.55); cursor: pointer; padding: 0;
    font-size: 15px; line-height: 1; transition: color .15s;
}
.attachment-item-remove:hover { color: #fff; }

/* floating toggle when sidebar collapsed */
#topbar-toggle {
    position: absolute; top: 14px; left: 14px; z-index: 10;
    background: none; border: none; cursor: pointer;
    color: var(--text-dim); padding: 5px; border-radius: 7px;
    display: none; align-items: center;
    transition: color .12s, background .12s;
}
#topbar-toggle.visible { display: flex; }
#topbar-toggle:hover { color: var(--text); background: var(--user-bubble); }

/* skip all transitions (used when opening existing threads) */
#main.instant, #main.instant * { transition-duration: 0s !important; }

/* ── main header (logo — idle: centered, active: top bar) */
#main-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding: 0 24px 28px;
    height: 44vh;
    flex-shrink: 0;
    transition: height 0.65s ease-in-out, padding 0.65s ease-in-out,
                border-color 0.3s ease-in-out;
    border-bottom: 1px solid transparent;
    overflow: hidden;
}
#main.active #main-header {
    height: 68px;
    border-bottom-color: var(--border);
}

#main-logo {
    width: 280px; height: auto; display: block;
    transition: width 0.65s ease-in-out;
    flex-shrink: 0;
}
#main.active #main-logo {
    width: 110px;
}

/* ── messages */
#messages {
    flex: 1; overflow-y: auto;
    padding: 16px 24px 8px;
    display: flex; flex-direction: column; gap: 0;
    scrollbar-width: thin;
    scrollbar-color: #d1d5db transparent;
    opacity: 0;
    pointer-events: none;
    /* Collapse to 0 in idle so input sits right below the header */
    max-height: 0;
    overflow: hidden;
    transition: opacity 0.5s ease-in-out, max-height 0.65s ease-in-out;
}
#main.active #messages {
    opacity: 1;
    pointer-events: auto;
    max-height: 100dvh;
    overflow-y: auto;
}


/* centered column for every row */
.msg-row {
    width: 100%; max-width: var(--col-max);
    margin: 0 auto; padding: 8px 0;
}

/* user: right-aligned pill */
.msg-row.user { display: flex; justify-content: flex-end; }
.msg-row.user > div { display: flex; flex-direction: column; align-items: flex-end; max-width: 82%; }
.msg-row.user .bubble {
    background: var(--user-bubble);
    border-radius: 18px 18px 4px 18px;
    padding: 10px 16px;
    font-size: 15px; line-height: 1.6;
    word-break: break-word;
    color: var(--text);
}

/* ARI: left-aligned plain text */
.msg-row.assistant { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; }
.msg-row.assistant .sender {
    font-size: 12px; font-weight: 700;
    letter-spacing: .04em; text-transform: uppercase;
    color: var(--sidebar-bg);
}
.msg-row.assistant .bubble {
    font-size: 15px; line-height: 1.7;
    word-break: break-word;
    color: var(--text); max-width: 100%;
}

/* ── markdown prose styles ───────────────────────────── */
.bubble p { margin: 0 0 .75em; }
.bubble p:last-child { margin-bottom: 0; }
.bubble h1,.bubble h2,.bubble h3,.bubble h4,.bubble h5,.bubble h6 {
    font-weight: 700; line-height: 1.3; margin: 1em 0 .4em;
    color: var(--text);
}
.bubble h1 { font-size: 1.35em; }
.bubble h2 { font-size: 1.2em; }
.bubble h3 { font-size: 1.05em; }
.bubble h4,.bubble h5,.bubble h6 { font-size: .95em; }
.bubble h1:first-child,.bubble h2:first-child,.bubble h3:first-child { margin-top: 0; }
.bubble ul,.bubble ol { padding-left: 1.5em; margin: .4em 0 .75em; }
.bubble li { margin: .25em 0; }
.bubble li > p { margin: 0; }
.bubble strong { font-weight: 700; }
.bubble em { font-style: italic; }
.bubble code {
    font-family: "SF Mono", ui-monospace, "Cascadia Code", Menlo, Consolas, monospace;
    font-size: .875em;
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    padding: 1px 5px;
}
.bubble .code-block {
    margin: .6em 0 .9em;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #3a3a4a;
}
.bubble .code-header {
    display: flex; align-items: center; justify-content: space-between;
    background: #2a2a3a;
    padding: 6px 12px 6px 14px;
    border-bottom: 1px solid #3a3a4a;
}
.bubble .code-lang {
    font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
    font-size: 11px;
    color: #858599;
    text-transform: lowercase;
    letter-spacing: .04em;
    user-select: none;
}
.bubble .code-copy-btn {
    background: none;
    border: none;
    padding: 3px;
    cursor: pointer;
    color: #666680;
    display: flex; align-items: center;
    border-radius: 4px;
    transition: color .15s, background .15s;
}
.bubble .code-copy-btn:hover { color: #cdd6f4; background: rgba(255,255,255,.08); }
.bubble .code-copy-btn.copied { color: #a6e3a1; }
.bubble .code-copy-btn svg { display: block; }
.bubble .code-block pre {
    background: #1e1e1e;
    border-radius: 0;
    padding: 14px 16px;
    overflow-x: auto;
    margin: 0;
}
.bubble pre code {
    background: none; border: none; padding: 0;
    font-size: .85em;
}
/* override hljs background so our wrapper controls it */
.bubble .hljs { background: transparent; padding: 0; }
.bubble blockquote {
    border-left: 3px solid var(--border);
    margin: .5em 0; padding: .3em 0 .3em 1em;
    color: var(--text-dim);
}
.bubble table { border-collapse: collapse; width: 100%; margin: .6em 0; font-size: 14px; }
.bubble th,.bubble td { border: 1px solid var(--border); padding: 6px 10px; text-align: left; }
.bubble th { background: #f9fafb; font-weight: 600; }
.bubble hr { border: none; border-top: 1px solid var(--border); margin: 1em 0; }
.bubble a { color: var(--accent); text-decoration: underline; }
/* user bubble markdown — same rules inherit; tweak inline code bg */
.msg-row.user .bubble code { background: rgba(0,0,0,.07); border-color: rgba(0,0,0,.1); }

/* ── bottom input ────────────────────────────────────── */
#input-area { padding: 10px 24px 20px; flex-shrink: 0; }

#input-wrap {
    max-width: var(--col-max); margin: 0 auto;
    background: var(--input-bg);
    border: 1px solid var(--input-border);
    border-radius: 16px;
    padding: 12px 12px 10px 16px;
    display: flex; flex-direction: column; gap: 8px;
    box-shadow: 0 1px 4px rgba(0,0,0,.06);
    transition: border-color .15s, box-shadow .15s;
}
#input-wrap:focus-within {
    border-color: var(--input-focus);
    box-shadow: 0 1px 8px rgba(0,0,0,.1);
}

#input {
    background: transparent; border: none; outline: none;
    color: var(--text); font-family: inherit; font-size: 15px;
    line-height: 1.55; resize: none;
    max-height: 180px; min-height: 24px; width: 100%;
}
#input::placeholder { color: #9ca3af; }

#input-footer { display: flex; justify-content: flex-end; align-items: center; gap: 4px; }

#btn-attach {
    width: 28px; height: 28px; border-radius: 50%;
    border: none; background: transparent;
    color: #9ca3af; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: color .15s; flex-shrink: 0;
}
#btn-attach:hover { color: var(--text); }

#input-hint {
    text-align: center; font-size: 12px; color: #9ca3af;
    margin-top: 6px;
    max-width: var(--col-max); margin-left: auto; margin-right: auto;
}

/* ── thought section ────────────────────────────────── */
.thought-block {
    margin-bottom: 6px;
    width: 100%;
}

.thought-block summary {
    font-size: 12px;
    color: var(--text-dim);
    cursor: pointer;
    user-select: none;
    list-style: none;
    display: flex; align-items: center; gap: 5px;
    padding: 2px 0;
}
.thought-block summary::-webkit-details-marker { display: none; }

.thought-block summary::before {
    content: '▶';
    font-size: 9px;
    color: var(--text-dim);
    transition: transform .15s;
    display: inline-block;
}
.thought-block[open] summary::before { transform: rotate(90deg); }

.thought-block summary:hover { color: var(--text); }

.thought-content {
    margin-top: 8px;
    padding: 10px 12px;
    width: 100%;
    box-sizing: border-box;
    background: #f9fafb;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 12px;
    color: #4b5563;
    white-space: pre-wrap;
    word-break: break-word;
    line-height: 1.6;
    max-height: 300px;
    overflow-y: auto;
}

.thought-content h4 {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .05em;
    text-transform: uppercase;
    color: #6b7280;
    margin-bottom: 4px;
}

.thought-content h4:not(:first-child) { margin-top: 12px; }

/* ── recall notes ───────────────────────────────────── */
.recall-notes-section {
    margin-bottom: 8px;
}

.recall-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .05em;
    text-transform: uppercase;
    color: #6b7280;
    margin-bottom: 4px;
}

.recall-note {
    margin-bottom: 2px;
}

.recall-note summary {
    font-size: 12px;
    color: var(--text-dim);
    cursor: pointer;
    user-select: none;
    list-style: none;
    display: flex; align-items: center; gap: 5px;
    padding: 1px 0;
}
.recall-note summary::-webkit-details-marker { display: none; }

.recall-note summary::before {
    content: '▶';
    font-size: 9px;
    color: var(--text-dim);
    transition: transform .15s;
    display: inline-block;
}
.recall-note[open] summary::before { transform: rotate(90deg); }
.recall-note summary:hover { color: var(--text); }

.recall-note-link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    opacity: 0.75;
}
.recall-note-link:hover { opacity: 1; }

.recall-note-content {
    margin: 4px 0 4px 16px;
    padding: 8px 10px;
    background: #f9fafb;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 12px;
    color: #4b5563;
    white-space: pre-wrap;
    word-break: break-word;
    line-height: 1.6;
    max-height: 200px;
    overflow-y: auto;
}

/* ── timestamps ─────────────────────────────────────── */
.msg-time {
    font-size: 11px;
    color: #9ca3af;
    margin-top: 4px;
}
.msg-row.user .msg-time { text-align: right; }
.msg-row.assistant .msg-time { text-align: left; }

/* ── typing indicator ────────────────────────────────── */
.typing-indicator {
    display: flex; align-items: center; gap: 5px;
    padding: 2px 0 6px;
}
.typing-indicator span {
    font-size: 13px; color: var(--text-dim);
    font-style: italic;
}
.typing-dots { display: flex; gap: 4px; align-items: center; }
.typing-dots b {
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--text-dim); display: block;
    animation: bounce 1.2s infinite ease-in-out;
}
.typing-dots b:nth-child(2) { animation-delay: .2s; }
.typing-dots b:nth-child(3) { animation-delay: .4s; }
@@keyframes bounce {
    0%, 80%, 100% { transform: translateY(0); opacity: .4; }
    40%           { transform: translateY(-4px); opacity: 1; }
}

/* ── send button ─────────────────────────────────────── */
.btn-send {
    width: 32px; height: 32px; border-radius: 8px; border: none;
    background: var(--accent); color: #fff;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; flex-shrink: 0;
    transition: background .15s, opacity .15s;
}
.btn-send:hover:not(:disabled) { background: var(--accent-hover); }
.btn-send:disabled { opacity: .3; cursor: default; }

/* ── internal thread toggle ──────────────────────────── */
#sidebar-internal-toggle {
    padding: 10px 16px 14px;
    border-top: 1px solid rgba(255,255,255,.07);
    flex-shrink: 0;
}
#sidebar-internal-toggle label {
    display: flex; align-items: center; gap: 8px;
    font-size: 12px; color: var(--sidebar-dim);
    cursor: pointer; user-select: none;
}
#sidebar-internal-toggle input[type=checkbox] {
    accent-color: var(--sidebar-text);
    width: 13px; height: 13px; cursor: pointer; flex-shrink: 0;
}

/* internal threads in the sidebar list */
#thread-list li.internal-thread {
    color: var(--sidebar-dim);
    font-style: italic;
}
#thread-list li.internal-thread.active { color: #fff; }

/* ── mobile / PWA ────────────────────────────────────── */
@@media (max-width: 640px) {
    #sidebar {
        position: fixed; top: 0; bottom: 0; left: 0; z-index: 200; height: 100dvh;
        width: var(--sidebar-w) !important; min-width: var(--sidebar-w) !important;
        transform: translateX(-100%);
        transition: transform .25s ease, box-shadow .25s ease;
        box-shadow: none;
    }
    #sidebar.mobile-open {
        transform: translateX(0);
        box-shadow: 4px 0 24px rgba(0,0,0,.35);
    }
    /* dim overlay behind the open drawer */
    #sidebar-overlay {
        display: none;
        position: fixed; inset: 0; z-index: 199;
        background: rgba(0,0,0,.4);
    }
    #sidebar-overlay.visible { display: block; }
    /* sidebar collapse/expand handled by mobile-open, not width transition */
    #sidebar.collapsed { transform: translateX(-100%); }
    #main { width: 100%; }
    #topbar-toggle { display: flex !important; }
    #input-area {
        padding-left: 16px; padding-right: 16px;
        padding-bottom: calc(14px + env(safe-area-inset-bottom, 0px));
    }
    #input-hint { display: none; }
    #main-logo { width: 200px; }
    #main.active #main-logo { width: 90px; }
    #main-header { height: 38vh; padding-bottom: 20px; }
}

/* ── internal thread message styles ─────────────────── */

/* system prompt — collapsible, full width, subtle */
.msg-row.internal-system {
    max-width: var(--col-max);
    margin: 0 auto;
    padding: 4px 0;
}
.system-block {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    background: #fafafa;
}
.system-block > summary {
    display: flex; align-items: center; justify-content: space-between;
    padding: 7px 12px;
    cursor: pointer; user-select: none;
    list-style: none;
    font-size: 12px; gap: 8px;
}
.system-block > summary::-webkit-details-marker { display: none; }
.system-block > summary::before {
    content: '▶'; font-size: 9px; color: var(--text-dim);
    transition: transform .15s; display: inline-block; flex-shrink: 0;
}
.system-block[open] > summary::before { transform: rotate(90deg); }
.system-block .sender {
    font-size: 11px; font-weight: 700; letter-spacing: .05em;
    text-transform: uppercase; color: #9ca3af; flex: 1;
}
.system-block .msg-time { font-size: 11px; color: #9ca3af; flex-shrink: 0; }
.system-bubble {
    padding: 10px 14px;
    font-size: 12px; line-height: 1.6;
    white-space: pre-wrap; word-break: break-word;
    color: #4b5563;
    border-top: 1px solid var(--border);
    max-height: 400px; overflow-y: auto;
}

/* prompt — left aligned, distinct from assistant */
.msg-row.internal-prompt {
    display: flex; flex-direction: column; align-items: flex-start;
    gap: 4px; max-width: var(--col-max); margin: 0 auto; padding: 8px 0;
}
.msg-row.internal-prompt .sender {
    font-size: 12px; font-weight: 700; letter-spacing: .04em;
    text-transform: uppercase; color: #9ca3af;
}
.msg-row.internal-prompt .bubble {
    font-size: 14px; line-height: 1.6;
    white-space: pre-wrap; word-break: break-word;
    color: var(--text-dim); max-width: 100%;
    background: #f9fafb; border: 1px solid var(--border);
    border-radius: 8px; padding: 10px 14px;
}

@model string?
@{
    Layout = "_Layout";
    ViewData["Title"] = "ARI";
}

<div id="shell">

    <!-- sidebar -->
    <aside id="sidebar">
        <div id="sidebar-inner">
            <div id="sidebar-header">
                <span id="sidebar-wordmark">A.R.I</span>
                <button id="btn-toggle-sidebar" title="Close sidebar">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/>
                    </svg>
                </button>
            </div>

            <button id="btn-new-chat">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                New chat
            </button>

            <div id="sidebar-section-label">Recents</div>
            <ul id="thread-list"></ul>

            <div id="sidebar-internal-toggle">
                <label>
                    <input type="checkbox" id="chk-show-internal" />
                    Show internal threads
                </label>
            </div>
        </div>
    </aside>

    <!-- floating toggle when sidebar is collapsed -->
    <button id="topbar-toggle" title="Open sidebar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/>
        </svg>
    </button>

    <!-- main -->
    <div id="main">

        <!-- landing: shown when no thread is active -->
        <div id="landing">
            <h1 id="landing-greeting">Hey, [REDACT].</h1>
            <div id="landing-input-wrap">
                <textarea id="landing-input" placeholder="Message ARI..." rows="1"></textarea>
                <div id="landing-input-footer">
                    <button class="btn-send" id="btn-landing-send" disabled title="Send">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- command popup (shared, moved in DOM by JS) -->
        <div id="cmd-popup" class="hidden">
            <ul id="cmd-list"></ul>
        </div>

        <!-- conversation: shown when a thread is active -->
        <div id="conversation" class="hidden">
            <div id="messages"></div>
            <div id="input-area">
                <div id="input-wrap">
                    <textarea id="input" placeholder="Message ARI..." rows="1"></textarea>
                    <div id="input-footer">
                        <button class="btn-send" id="btn-send" disabled title="Send">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
                        </button>
                    </div>
                </div>
                <p id="input-hint">Enter to send &nbsp;·&nbsp; Shift+Enter for new line</p>
            </div>
        </div>

    </div>
</div>

@section Styles {
<style>
#thread-list li.pending {
    opacity: 0.6;
    font-style: italic;
}
#cmd-popup {
    position: absolute;
    bottom: 100%;
    left: 0; right: 0;
    margin-bottom: 6px;
    background: #CADDE2;
    border: 1px solid var(--border, #313244);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0,0,0,.45);
    z-index: 200;
}
#cmd-popup.hidden { display: none; }
#cmd-list {
    list-style: none;
    margin: 0; padding: 4px;
}
#cmd-list li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 7px 12px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.875rem;
    transition: background 0.1s;
}
#cmd-list li:hover,
#cmd-list li.active {
    background: var(--accent-dim, rgba(137,180,250,.15));
}
#cmd-list li .cmd-name {
    font-weight: 600;
    color: var(--accent, #89b4fa);
    white-space: nowrap;
}
#cmd-list li .cmd-desc {
    color: var(--subtext, #a6adc8);
    font-size: 0.8rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
</style>
}

@section Scripts {
<script>
    // ── slash-command popup ──────────────────────────────
    const COMMANDS = [
        { cmd: '/engram on',       desc: 'Enable engram memory extraction' },
        { cmd: '/engram off',      desc: 'Disable engram memory extraction' },
        { cmd: '/engram sweep',    desc: 'Run a manual engram sweep now' },
        { cmd: '/engram status',   desc: 'Show engram enabled/disabled state' },
        { cmd: '/refactor',        desc: 'Incremental refactor — process dirty notes + 1-hop neighbours' },
        { cmd: '/refactor all',    desc: 'Full graph refactor — scans every note (use for first run or rebuild)' },
        { cmd: '/purge notes',     desc: 'Delete all notes from the brain' },
        { cmd: '/brain backup',    desc: 'Export a backup of the brain' },
    ];

    const cmdPopup  = document.getElementById('cmd-popup');
    const cmdList   = document.getElementById('cmd-list');
    let cmdMatches  = [];
    let cmdIndex    = -1;   // highlighted item (-1 = none)
    let cmdTarget   = null; // the textarea currently driving the popup

    function showCmdPopup(textarea) {
        // Anchor the popup relative to the textarea's wrapper
        const wrap = textarea.closest('#input-wrap, #landing-input-wrap');
        if (!wrap) return;
        wrap.style.position = 'relative';
        wrap.appendChild(cmdPopup);
        cmdPopup.classList.remove('hidden');
    }

    function hideCmdPopup() {
        cmdPopup.classList.add('hidden');
        cmdMatches = [];
        cmdIndex   = -1;
        cmdTarget  = null;
    }

    function renderCmdPopup() {
        cmdList.innerHTML = '';
        cmdMatches.forEach((c, i) => {
            const li = document.createElement('li');
            if (i === cmdIndex) li.classList.add('active');
            li.innerHTML =
                `<span class="cmd-name">${escHtmlCmd(c.cmd)}</span>` +
                `<span class="cmd-desc">${escHtmlCmd(c.desc)}</span>`;
            li.addEventListener('mousedown', e => {
                e.preventDefault(); // don't blur textarea
                applyCmdItem(c);
            });
            cmdList.appendChild(li);
        });
    }

    function escHtmlCmd(s) {
        return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    function applyCmdItem(c) {
        if (!cmdTarget) return;
        cmdTarget.value = c.cmd + ' ';
        cmdTarget.dispatchEvent(new Event('input'));
        hideCmdPopup();
        cmdTarget.focus();
    }

    function updateCmdPopup(textarea) {
        const val = textarea.value;
        if (!val.startsWith('/')) { hideCmdPopup(); return; }

        const query = val.toLowerCase();
        cmdMatches  = COMMANDS.filter(c => c.cmd.toLowerCase().startsWith(query));
        // exact match already typed — hide
        if (cmdMatches.length === 0 || cmdMatches.some(c => c.cmd.toLowerCase() === query.trimEnd())) {
            hideCmdPopup(); return;
        }

        cmdTarget = textarea;
        if (cmdIndex >= cmdMatches.length) cmdIndex = cmdMatches.length - 1;
        renderCmdPopup();
        showCmdPopup(textarea);
    }

    function wireCmdPopup(textareaId) {
        const el = document.getElementById(textareaId);

        el.addEventListener('input', () => updateCmdPopup(el));

        el.addEventListener('keydown', e => {
            if (cmdPopup.classList.contains('hidden')) return;
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                cmdIndex = (cmdIndex + 1) % cmdMatches.length;
                renderCmdPopup();
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                cmdIndex = (cmdIndex - 1 + cmdMatches.length) % cmdMatches.length;
                renderCmdPopup();
            } else if (e.key === 'Tab') {
                e.preventDefault();
                const pick = cmdIndex >= 0 ? cmdMatches[cmdIndex] : cmdMatches[0];
                if (pick) applyCmdItem(pick);
            } else if (e.key === 'Escape') {
                hideCmdPopup();
            }
        });

        el.addEventListener('blur', () => {
            // short delay so mousedown on popup fires first
            setTimeout(() => { if (document.activeElement !== el) hideCmdPopup(); }, 120);
        });
    }

    wireCmdPopup('input');
    wireCmdPopup('landing-input');

    let activeThread        = null;
    let isStreaming         = false;
    let knownMsgCount       = 0;
    let activeThreadInternal = false; // true when viewing an internal model thread

    // ── sidebar ─────────────────────────────────────────
    const sidebar   = document.getElementById('sidebar');
    const floatBtn  = document.getElementById('topbar-toggle');

    function setSidebarCollapsed(collapsed) {
        sidebar.classList.toggle('collapsed', collapsed);
        floatBtn.classList.toggle('visible', collapsed);
    }

    document.getElementById('btn-toggle-sidebar').addEventListener('click', () => setSidebarCollapsed(true));
    floatBtn.addEventListener('click', () => setSidebarCollapsed(false));

    // ── thread list ─────────────────────────────────────
    async function loadThreads() {
        try {
            const showInternal = document.getElementById('chk-show-internal').checked;
            const url = showInternal ? '/api/threads?includeInternal=true' : '/api/threads';
            const res = await fetch(url);
            const threads = await res.json();
            const list = document.getElementById('thread-list');
            list.innerHTML = '';

            threads.forEach(t => {
                const li = document.createElement('li');
                li.dataset.key      = t.key;
                li.dataset.internal = t.isInternal ? '1' : '0';
                if (t.key === activeThread) li.classList.add('active');
                if (t.isInternal) li.classList.add('internal-thread');

                let label;
                if (t.isInternal) {
                    label = t.modelName ?? 'Internal';
                } else {
                    label = t.key.startsWith('web-') ? 'Web chat' : 'Discord';
                }

                const time = t.lastMessageAt && !t.lastMessageAt.startsWith('0001')
                    ? new Date(t.lastMessageAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
                    : '';

                li.innerHTML = `<span class="thread-time">${time}</span>${label}`;
                li.addEventListener('click', () => openThread(t.key, t.isInternal, t.modelName));
                list.appendChild(li);
            });
        } catch { /* silently ignore network hiccups during thread list refresh */ }
    }

    document.getElementById('chk-show-internal').addEventListener('change', loadThreads);

    document.getElementById('btn-new-chat').addEventListener('click', async () => {
        const res = await fetch('/api/threads', { method: 'POST' });
        const { key } = await res.json();
        await loadThreads();
        openThread(key);
    });

    // ── open thread ─────────────────────────────────────
    async function openThread(key, isInternal = false, modelName = null) {
        activeThread         = key;
        activeThreadInternal = isInternal;

        document.querySelectorAll('#thread-list li').forEach(li =>
            li.classList.toggle('active', li.dataset.key === key));

        const url  = isInternal ? `/api/threads/${key}/history?raw=true` : `/api/threads/${key}/history`;
        const res  = await fetch(url);
        const msgs = await res.json();

        const box = document.getElementById('messages');
        box.innerHTML = '';
        msgs.forEach(m => appendRow(m.role, m.content, m.timestamp, m.thinkingSeconds, m.recallNotes, m.contextSummary, isInternal, modelName));
        knownMsgCount = msgs.length;

        showConversation();

        // Hide input area for internal (read-only) threads
        document.getElementById('input-area').style.display = isInternal ? 'none' : '';

        scrollBottom();
        if (!isInternal) document.getElementById('input').focus();
    }

    // poll active thread for new messages (catches Discord replies)
    async function pollActiveThread() {
        if (!activeThread || isStreaming || activeThreadInternal) return;
        try {
            const res  = await fetch(`/api/threads/${activeThread}/history`);
            const msgs = await res.json();
            if (msgs.length > knownMsgCount) {
                const box = document.getElementById('messages');
                for (let i = knownMsgCount; i < msgs.length; i++) {
                    const m = msgs[i];
                    appendRow(m.role, m.content, m.timestamp, m.thinkingSeconds, m.recallNotes, m.contextSummary);
                }
                knownMsgCount = msgs.length;
                scrollBottom();
            }
        } catch { /* silently ignore network hiccups */ }
    }

    function showConversation() {
        document.getElementById('landing').classList.add('hidden');
        document.getElementById('conversation').classList.remove('hidden');
    }

    // ── send ─────────────────────────────────────────────

    // Immediately injects a pending thread entry into the sidebar so it appears
    // as soon as the user sends — before ARI has responded.
    function injectPendingThread(key) {
        const list = document.getElementById('thread-list');
        // Remove any stale pending entry for this key first
        list.querySelector(`li[data-key="${key}"]`)?.remove();
        const li = document.createElement('li');
        li.dataset.key      = key;
        li.dataset.internal = '0';
        li.classList.add('active', 'pending');
        li.innerHTML = `<span class="thread-time">now</span>Web chat`;
        li.addEventListener('click', () => openThread(key));
        list.prepend(li);
    }

    async function send(prompt, fromLanding) {
        if (isStreaming || !prompt) return;

        // if sent from landing, create a new thread first
        if (fromLanding || !activeThread) {
            const res = await fetch('/api/threads', { method: 'POST' });
            const { key } = await res.json();
            activeThread = key;
            injectPendingThread(key);
            showConversation();
        }

        // Slash commands go to the command API, not the LLM stream
        if (prompt.startsWith('/')) {
            appendRow('user', prompt, new Date().toISOString());
            scrollBottom();
            showTyping();
            try {
                const res = await fetch('/api/commands', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ input: prompt })
                });
                hideTyping();
                const data = await res.json();
                const reply = res.ok ? (data.result ?? 'Done.') : (data.error ?? 'Command failed.');
                appendRow('assistant', reply, new Date().toISOString());
            } catch {
                hideTyping();
                appendRow('assistant', 'Command failed — could not reach ARI.', new Date().toISOString());
            }
            knownMsgCount += 2;
            scrollBottom();
            return;
        }

        isStreaming = true;
        updateButtons();

        appendRow('user', prompt, new Date().toISOString());
        showTyping();
        scrollBottom();

        const url = `/api/threads/${activeThread}/stream?prompt=${encodeURIComponent(prompt)}`;
        const es  = new EventSource(url);

        let ariRow = null;
        let bubbleEl = null;

        es.onmessage = e => {
            if (e.data === '[DONE]') {
                es.close(); isStreaming = false; knownMsgCount += 2; updateButtons(); loadThreads();
                // refresh the last ARI row to attach thought metadata
                refreshLastAriRow();
                return;
            }
            if (e.data.startsWith('[ERROR]')) {
                hideTyping();
                appendRow('assistant', e.data.replace('[ERROR] ', ''), new Date().toISOString());
                es.close(); isStreaming = false; updateButtons(); return;
            }
            if (!ariRow) {
                hideTyping();
                ariRow   = appendRow('assistant', '', new Date().toISOString());
                bubbleEl = ariRow.querySelector('.bubble');
            }
            bubbleEl.textContent = e.data.replace(/\\n/g, '\n');
            scrollBottom();
        };

        es.onerror = () => {
            hideTyping();
            if (!ariRow) appendRow('assistant', '[connection error]', new Date().toISOString());
            es.close(); isStreaming = false; updateButtons();
        };
    }

    // landing send
    document.getElementById('btn-landing-send').addEventListener('click', () => {
        const el = document.getElementById('landing-input');
        const t  = el.value.trim();
        if (!t) return;
        el.value = ''; el.style.height = 'auto';
        send(t, true);
    });

    // conversation send
    document.getElementById('btn-send').addEventListener('click', () => {
        const el = document.getElementById('input');
        const t  = el.value.trim();
        if (!t) return;
        el.value = ''; el.style.height = 'auto';
        send(t, false);
    });

    // ── helpers ──────────────────────────────────────────
    function appendRow(role, content, timestamp, thinkingSeconds, recallNotes, contextSummary, isInternal = false, modelName = null) {
        const box = document.getElementById('messages');
        const row = document.createElement('div');

        const timeStr = timestamp
            ? new Date(timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
            : '';

        if (isInternal) {
            // Internal thread rendering: system/user = left, assistant = right
            if (role === 'system') {
                row.className = 'msg-row internal-system';
                row.innerHTML =
                    `<details class="system-block">` +
                    `<summary><span class="sender">System</span><span class="msg-time">${timeStr}</span></summary>` +
                    `<div class="bubble system-bubble"></div>` +
                    `</details>`;
                row.querySelector('.system-bubble').textContent = content;
            } else if (role === 'user') {
                row.className = 'msg-row internal-prompt';
                row.innerHTML =
                    `<div class="sender">Prompt</div>` +
                    `<div class="bubble"></div>` +
                    `<div class="msg-time">${timeStr}</div>`;
                row.querySelector('.bubble').textContent = content;
            } else {
                // assistant — right side, labelled by model name
                row.className = 'msg-row assistant';
                let thoughtHtml = '';
                if (thinkingSeconds != null) {
                    const secs = typeof thinkingSeconds === 'number' ? thinkingSeconds.toFixed(1) : thinkingSeconds;
                    thoughtHtml =
                        `<details class="thought-block" style="pointer-events:none">` +
                        `<summary>${modelName ?? 'Model'} responded in ${secs}s</summary>` +
                        `</details>`;
                }
                row.innerHTML =
                    `<div class="sender">${escHtml(modelName ?? 'Model')}</div>` +
                    thoughtHtml +
                    `<div class="bubble"></div>` +
                    `<div class="msg-time">${timeStr}</div>`;
                row.querySelector('.bubble').textContent = content;
            }
        } else {
            // Normal dialogue rendering
            row.className = `msg-row ${role}`;
            if (role === 'user') {
                row.innerHTML = `<div><div class="bubble"></div><div class="msg-time">${timeStr}</div></div>`;
            } else {
                let thoughtHtml = '';
                if (thinkingSeconds != null) {
                    const secs = typeof thinkingSeconds === 'number' ? thinkingSeconds.toFixed(1) : thinkingSeconds;
                    let detailParts = '';
                    if (recallNotes)    detailParts += `<h4>Recalled memories</h4>${escHtml(recallNotes)}\n`;
                    if (contextSummary) detailParts += `<h4>Context summary</h4>${escHtml(contextSummary)}`;
                    const hasDetails = detailParts.length > 0;
                    thoughtHtml =
                        `<details class="thought-block"${hasDetails ? '' : ' style="pointer-events:none"'}>` +
                        `<summary>ARI thought for ${secs}s</summary>` +
                        (hasDetails ? `<div class="thought-content">${detailParts}</div>` : '') +
                        `</details>`;
                }
                row.innerHTML =
                    `<div class="sender">ARI</div>` +
                    thoughtHtml +
                    `<div class="bubble"></div>` +
                    `<div class="msg-time">${timeStr}</div>`;
            }
            row.querySelector('.bubble').textContent = content;
        }

        box.appendChild(row);
        return row;
    }

    async function refreshLastAriRow() {
        if (!activeThread) return;
        try {
            const res  = await fetch(`/api/threads/${activeThread}/history`);
            const msgs = await res.json();
            if (!msgs.length) return;
            const last = msgs[msgs.length - 1];
            if (last.role !== 'assistant') return;
            // replace the last .msg-row.assistant in the box
            const box  = document.getElementById('messages');
            const rows = box.querySelectorAll('.msg-row.assistant');
            if (!rows.length) return;
            const lastRow = rows[rows.length - 1];
            const replacement = document.createElement('div');
            replacement.className = 'msg-row assistant';
            box.insertBefore(replacement, lastRow);
            box.removeChild(lastRow);
            // re-render into replacement
            const tmp = appendRow(last.role, last.content, last.timestamp, last.thinkingSeconds, last.recallNotes, last.contextSummary);
            replacement.replaceWith(tmp);
        } catch { /* ignore */ }
    }

    function escHtml(str) {
        return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    function showTyping() {
        const box = document.getElementById('messages');
        const row = document.createElement('div');
        row.className = 'msg-row assistant';
        row.id = 'typing-indicator';
        row.innerHTML =
            `<div class="sender">ARI</div>` +
            `<div class="typing-indicator">` +
            `<span>A.R.I is thinking</span>` +
            `<div class="typing-dots"><b></b><b></b><b></b></div>` +
            `</div>`;
        box.appendChild(row);
        scrollBottom();
    }

    function hideTyping() {
        document.getElementById('typing-indicator')?.remove();
    }

    function scrollBottom() {
        const box = document.getElementById('messages');
        box.scrollTop = box.scrollHeight;
    }

    function updateButtons() {
        const landingText = document.getElementById('landing-input').value.trim();
        const chatText    = document.getElementById('input').value.trim();
        document.getElementById('btn-landing-send').disabled = isStreaming || !landingText;
        document.getElementById('btn-send').disabled         = isStreaming || !chatText;
    }

    // ── auto-resize + keydown for all textareas ──────────
    function wireTextarea(id, sendFn) {
        const el = document.getElementById(id);
        el.addEventListener('input', function () {
            this.style.height = 'auto';
            this.style.height = Math.min(this.scrollHeight, 180) + 'px';
            updateButtons();
        });
        el.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendFn(); }
        });
    }

    wireTextarea('landing-input', () => {
        const el = document.getElementById('landing-input');
        const t  = el.value.trim(); if (!t) return;
        el.value = ''; el.style.height = 'auto'; send(t, true);
    });

    wireTextarea('input', () => {
        const el = document.getElementById('input');
        const t  = el.value.trim(); if (!t) return;
        el.value = ''; el.style.height = 'auto'; send(t, false);
    });

    // ── wait for ARI to be ready (polls /api/threads until not 503) ──
    async function waitForReady() {
        const greeting = document.getElementById('landing-greeting');
        while (true) {
            const res = await fetch('/api/threads').catch(() => null);
            if (res && res.status !== 503) {
                if (greeting) greeting.textContent = 'Hey, [REDACT].';
                await loadThreads();
                return;
            }
            if (greeting) greeting.textContent = 'A.R.I is starting up…';
            await new Promise(r => setTimeout(r, 2000));
        }
    }

    // ── init ─────────────────────────────────────────────
    (async () => {
        try {
            await waitForReady();
            const initial = '@Html.Raw(Model ?? "")';
            if (initial) openThread(initial);
            setInterval(loadThreads, 5000);
            setInterval(pollActiveThread, 3000);
        } catch (err) {
            console.error('ARI init failed:', err);
            setTimeout(() => location.reload(), 2000);
        }
    })();
</script>
}

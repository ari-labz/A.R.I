@model string?
@{
    Layout = "_Layout";
    ViewData["Title"] = "A·R·I";
}

<div id="shell">

    <!-- sidebar -->
    <aside id="sidebar">
        <div id="sidebar-inner">
            <div id="sidebar-header">
                <img id="sidebar-wordmark" src="/images/logo-white.png?v=2" alt="A·R·I" />
                <button id="btn-toggle-sidebar" title="Close sidebar">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/>
                    </svg>
                </button>
            </div>

            <button id="btn-new-chat">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                New chat
            </button>

            <div id="sidebar-section-label">Recents</div>
            <ul id="thread-list"></ul>

            <div id="sidebar-internal-toggle">
                <label>
                    <input type="checkbox" id="chk-show-internal" />
                    Show internal threads
                </label>
            </div>
        </div>
    </aside>

    <!-- dim overlay for mobile sidebar -->
    <div id="sidebar-overlay"></div>

    <!-- floating toggle when sidebar is collapsed -->
    <button id="topbar-toggle" title="Open sidebar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/>
        </svg>
    </button>

    <!-- main (unified — no page switching) -->
    <div id="main">

        <!-- drag-drop overlay — two zones, shown while files are being dragged -->
        <div id="drop-overlay" style="display:none">
            <div id="drop-zone-thread" class="drop-zone">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="17" x2="12" y2="3"/><polyline points="8 7 12 3 16 7"/>
                    <path d="M20 21H4"/><line x1="17" y1="14" x2="17" y2="21"/><line x1="7" y1="14" x2="7" y2="21"/>
                </svg>
                <p class="drop-zone-title">Pin to thread</p>
                <p class="drop-zone-sub">Always in context</p>
            </div>
            <div id="drop-zone-message" class="drop-zone">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
                <p class="drop-zone-title">Attach to message</p>
                <p class="drop-zone-sub">Sent with your next message</p>
            </div>
        </div>

        <!-- chat column -->
        <div id="chat-col">

            <!-- logo header: tall+centered in idle, compact at top when active -->
            <div id="main-header">
                <img id="main-logo" src="/images/logo-black.png?v=2" alt="A·R·I" />
            </div>

            <!-- messages + thread panel share this zone -->
            <div id="messages-wrap">
                <!-- toggle to open thread panel (mirrors main sidebar toggle, flipped) -->
                <button id="btn-open-thread-panel" title="Open thread panel">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M15 3v18"/>
                    </svg>
                </button>
                <div id="messages"></div>

                <!-- command popup -->
                <div id="cmd-popup" class="hidden">
                    <ul id="cmd-list"></ul>
                </div>

                <!-- right thread-management sidebar — scoped to messages area -->
                <aside id="thread-panel">
                    <div id="thread-panel-inner">
                        <div id="thread-panel-header">
                            <span>Thread</span>
                            <button id="btn-close-thread-panel" title="Close">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                            </button>
                        </div>
                        <div class="thread-panel-section">
                            <div class="thread-panel-section-label">
                                Attachments
                                <button id="btn-attach-panel" title="Add file">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                </button>
                            </div>
                            <ul id="attachment-list"><li class="attachment-empty">No attachments</li></ul>
                        </div>
                    </div>
                </aside>
            </div><!-- /messages-wrap -->

            <!-- input: always at the bottom -->
            <div id="input-area">
                <div id="input-wrap">
                    <div id="msg-attach-preview"></div>
                    <textarea id="input" placeholder="Message A·R·I..." rows="1"></textarea>
                    <div id="input-footer">
                        <button id="btn-attach" title="Attach file" type="button">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                        </button>
                        <input type="file" id="file-input" multiple style="display:none">
                        <button class="btn-send" id="btn-send" disabled title="Send">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
                        </button>
                    </div>
                </div>
            <p id="input-hint">Enter to send &nbsp;·&nbsp; Shift+Enter for new line</p>
            <script>if (window.matchMedia('(pointer: coarse)').matches) { document.getElementById('input-hint').textContent = 'Enter for new line · Send button to send'; }</script>
        </div>

        </div><!-- /chat-col -->

    </div><!-- /main -->
</div>

@section Styles {
<style>

/* ── Drop overlay — two zones ─────────────────────────────────────── */
#drop-overlay {
    position: absolute;
    inset: 0;
    z-index: 500;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    background: rgba(0,0,0,0.55);
    backdrop-filter: blur(4px);
    border-radius: inherit;
    align-items: stretch;
    justify-content: center;
}
.drop-zone {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 32px 20px;
    border: 2px dashed rgba(255,255,255,0.25);
    border-radius: 16px;
    color: rgba(255,255,255,0.7);
    cursor: pointer;
    pointer-events: all;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
}
.drop-zone.drag-over {
    border-color: var(--accent, #89b4fa);
    background: rgba(137,180,250,0.14);
    color: #fff;
}
.drop-zone-title {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0;
}
.drop-zone-sub {
    font-size: 0.78rem;
    opacity: 0.65;
    margin: 0;
}

/* ── Pre-send message attachment preview ──────────────────────────── */
#msg-attach-preview {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 8px 8px 0;
}
#msg-attach-preview:empty { display: none; }

.msg-attach-chip {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--input-bg, #f0f4f8);
    border: 1px solid var(--border, #dde3ea);
    border-radius: 10px;
    padding: 6px 10px 6px 8px;
    max-width: 200px;
    cursor: default;
}
.msg-attach-chip img {
    width: 40px;
    height: 40px;
    object-fit: cover;
    border-radius: 6px;
    flex-shrink: 0;
}
.msg-attach-chip .chip-file-icon {
    width: 40px;
    height: 40px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    flex-shrink: 0;
    background: var(--accent-dim, rgba(137,180,250,.18));
    color: var(--accent, #89b4fa);
}
.msg-attach-chip .chip-name {
    font-size: 0.78rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 120px;
    color: var(--text, #1e1e2e);
}
.msg-attach-chip .chip-remove {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    font-size: 1rem;
    line-height: 1;
    color: var(--subtext, #a6adc8);
    flex-shrink: 0;
}
.msg-attach-chip .chip-remove:hover { color: var(--text, #1e1e2e); }
/* ── Toast ────────────────────────────────────────────────────────── */
.toast {
    position: fixed;
    bottom: 80px;
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    background: #2a2a3a;
    color: #f0f0f0;
    padding: 10px 18px;
    border-radius: 10px;
    font-size: 0.85rem;
    box-shadow: 0 4px 16px rgba(0,0,0,0.35);
    opacity: 0;
    transition: opacity 0.2s, transform 0.2s;
    z-index: 9999;
    max-width: 360px;
    text-align: center;
    pointer-events: none;
}
.toast.toast-visible {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
}

.msg-attach-chip.uploading { opacity: 0.6; }
.chip-uploading-icon { animation: chip-pulse 1s ease-in-out infinite; }
@@keyframes chip-pulse { 0%,100% { opacity: 0.4; } 50% { opacity: 1; } }

/* ── Thread-pin fly animation ─────────────────────────────────────── */
.attach-fly {
    position: fixed;
    z-index: 9000;
    pointer-events: none;
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--surface, #fff);
    border: 1.5px solid var(--accent, #89b4fa);
    border-radius: 10px;
    padding: 7px 13px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text, #1e1e2e);
    box-shadow: 0 4px 20px rgba(0,0,0,0.18);
    transform-origin: center;
    animation: attach-fly-anim 0.55s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}
.attach-fly svg { flex-shrink: 0; color: var(--accent, #89b4fa); }
@@keyframes attach-fly-anim {
    0%   { opacity: 1; transform: translate(0, 0) scale(1); }
    65%  { opacity: 1; transform: translate(var(--fly-x), var(--fly-y)) scale(0.88); }
    100% { opacity: 0; transform: translate(var(--fly-x), var(--fly-y)) scale(0.7); }
}

/* ── Thread panel spring peek ─────────────────────────────────────── */
/*
    Each segment has its own easing, like a ball bouncing sideways:
      - ease-in  = accelerating toward the apex (ball falling)
      - linear   = dwelling at the apex (ball at peak, clustered frames)
      - ease-out = decelerating away from the apex (ball rising)
*/
@@keyframes panel-peek {
    /* Physically derived (b₀=2.4, m=0.54, g=6). Panel=220px, right=12px → off-screen=240px.
       40% visible=88px → translateX(144px). Peaks decay by m²=0.2916 per bounce.
       position:fixed top is set by JS from a live measurement so it matches the open panel exactly. */
    0%   { transform: translateX(240px); animation-timing-function: cubic-bezier(0, 0.67, 0.33, 1); } /* impact 0 */
    27%  { transform: translateX(144px); animation-timing-function: cubic-bezier(0.67, 0, 1, 0.33); } /* apex 0  — 40% visible */
    53%  { transform: translateX(240px); animation-timing-function: cubic-bezier(0, 0.67, 0.33, 1); } /* impact 1 */
    68%  { transform: translateX(214px); animation-timing-function: cubic-bezier(0.67, 0, 1, 0.33); } /* apex 1  — ~12% visible */
    82%  { transform: translateX(240px); animation-timing-function: cubic-bezier(0, 0.67, 0.33, 1); } /* impact 2 */
    90%  { transform: translateX(232px); animation-timing-function: cubic-bezier(0.67, 0, 1, 0.33); } /* apex 2  —  ~3% visible */
    100% { transform: translateX(240px); }                                                              /* impact 3 */
}
#thread-panel.panel-peek {
    display: flex;
    animation: panel-peek 1.05s linear forwards;
}

/* ── Pinned-to-thread notice ──────────────────────────────────────── */
.msg-row.thread-pin-notice {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 6px 0 2px;
    font-size: 0.78rem;
    color: var(--subtext, #a6adc8);
    user-select: none;
}
.msg-row.thread-pin-notice svg { flex-shrink: 0; opacity: 0.7; }

/* ── Chat attachment bubbles ──────────────────────────────────────── */
.msg-row.attach-image > div,
.msg-row.attach-file  > div {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
}
.msg-image {
    max-width: 320px;
    max-height: 320px;
    width: auto;
    height: auto;
    border-radius: 12px;
    display: block;
    object-fit: cover;
}
.file-card {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--bubble-user, #e8f0fe);
    border-radius: 12px;
    padding: 10px 14px;
    max-width: 260px;
}
.file-card-icon {
    width: 42px;
    height: 42px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    flex-shrink: 0;
    background: rgba(137,180,250,.22);
    color: var(--accent, #89b4fa);
}
.file-card-name {
    font-size: 0.82rem;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 180px;
    color: var(--text, #1e1e2e);
}

.msg-row.memory-event {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
}
.memory-block {
    max-width: 100%;
}
.memory-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 6px;
}
.memory-change {
    font-size: 0.82rem;
    color: var(--subtext, #a6adc8);
    line-height: 1.4;
}
.memory-op {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 1px 5px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}
.memory-op-created {
    background: rgba(166,227,161,0.15);
    color: #a6e3a1;
}
.memory-op-updated {
    background: rgba(137,180,250,0.15);
    color: #89b4fa;
}
.memory-summary {
    color: var(--subtext, #a6adc8);
    font-size: 0.8rem;
}
.msg-row.command-exchange {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
}
.command-input {
    font-family: monospace;
    font-size: 13px;
    color: var(--text-dim);
}
.command-response-block {
    border-left: 2px solid var(--accent);
    padding: 6px 12px;
    background: var(--input-bg);
    border-radius: 0 8px 8px 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-dim);
    max-width: 100%;
}

#thread-list li.pending {
    opacity: 0.6;
    font-style: italic;
}
#cmd-popup {
    position: absolute;
    bottom: 100%;
    left: 0; right: 0;
    margin-bottom: 6px;
    background: #CADDE2;
    border: 1px solid var(--border, #313244);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0,0,0,.45);
    z-index: 200;
}
#cmd-popup.hidden { display: none; }
#cmd-list {
    list-style: none;
    margin: 0; padding: 4px;
}
#cmd-list li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 7px 12px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.875rem;
    transition: background 0.1s;
}
#cmd-list li:hover,
#cmd-list li.active {
    background: var(--accent-dim, rgba(137,180,250,.15));
}
#cmd-list li .cmd-name {
    font-weight: 600;
    color: var(--accent, #89b4fa);
    white-space: nowrap;
}
#cmd-list li .cmd-desc {
    color: var(--subtext, #a6adc8);
    font-size: 0.8rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
</style>
}

@section Scripts {
<script>
    // ── activate chat (idle → active) ───────────────────
    function activateChat(instant = false) {
        const main = document.getElementById('main');
        if (instant) {
            main.classList.add('instant');
            main.classList.add('active');
            // Two rAFs: let 'instant' apply before removing it
            requestAnimationFrame(() => requestAnimationFrame(() => {
                main.classList.remove('instant');
            }));
        } else {
            main.classList.add('active');
        }
    }

    function resetToIdle() {
        const main = document.getElementById('main');
        main.classList.add('instant');
        main.classList.remove('active');
        document.getElementById('messages').innerHTML = '';
        requestAnimationFrame(() => requestAnimationFrame(() => {
            main.classList.remove('instant');
        }));
    }

    // ── slash-command popup ──────────────────────────────
    const COMMANDS = [
        { cmd: '/engram on',       desc: 'Enable engram memory extraction' },
        { cmd: '/engram off',      desc: 'Disable engram memory extraction' },
        { cmd: '/engram sweep',    desc: 'Run a manual engram sweep now' },
        { cmd: '/engram status',   desc: 'Show engram enabled/disabled state' },
        { cmd: '/refactor',        desc: 'Incremental refactor — process dirty notes + 1-hop neighbours' },
        { cmd: '/refactor all',    desc: 'Full graph refactor — scans every note (use for first run or rebuild)' },
        { cmd: '/purge notes',     desc: 'Delete all notes from the brain' },
        { cmd: '/brain backup',    desc: 'Export a backup of the brain' },
    ];

    const cmdPopup  = document.getElementById('cmd-popup');
    const cmdList   = document.getElementById('cmd-list');
    let cmdMatches  = [];
    let cmdIndex    = -1;   // highlighted item (-1 = none)
    let cmdTarget   = null; // the textarea currently driving the popup

    function showCmdPopup(textarea) {
        // Anchor the popup relative to the textarea's wrapper
        const wrap = textarea.closest('#input-wrap, #landing-input-wrap');
        if (!wrap) return;
        wrap.style.position = 'relative';
        wrap.appendChild(cmdPopup);
        cmdPopup.classList.remove('hidden');
    }

    function hideCmdPopup() {
        cmdPopup.classList.add('hidden');
        cmdMatches = [];
        cmdIndex   = -1;
        cmdTarget  = null;
    }

    function renderCmdPopup() {
        cmdList.innerHTML = '';
        cmdMatches.forEach((c, i) => {
            const li = document.createElement('li');
            if (i === cmdIndex) li.classList.add('active');
            li.innerHTML =
                `<span class="cmd-name">${escHtmlCmd(c.cmd)}</span>` +
                `<span class="cmd-desc">${escHtmlCmd(c.desc)}</span>`;
            li.addEventListener('mousedown', e => {
                e.preventDefault(); // don't blur textarea
                applyCmdItem(c);
            });
            cmdList.appendChild(li);
        });
    }

    function escHtmlCmd(s) {
        return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    function applyCmdItem(c) {
        if (!cmdTarget) return;
        cmdTarget.value = c.cmd + ' ';
        cmdTarget.dispatchEvent(new Event('input'));
        hideCmdPopup();
        cmdTarget.focus();
    }

    function updateCmdPopup(textarea) {
        const val = textarea.value;
        if (!val.startsWith('/')) { hideCmdPopup(); return; }

        const query = val.toLowerCase();
        cmdMatches  = COMMANDS.filter(c => c.cmd.toLowerCase().startsWith(query));
        // exact match already typed — hide
        if (cmdMatches.length === 0 || cmdMatches.some(c => c.cmd.toLowerCase() === query.trimEnd())) {
            hideCmdPopup(); return;
        }

        cmdTarget = textarea;
        if (cmdIndex >= cmdMatches.length) cmdIndex = cmdMatches.length - 1;
        renderCmdPopup();
        showCmdPopup(textarea);
    }

    function wireCmdPopup(textareaId) {
        const el = document.getElementById(textareaId);

        el.addEventListener('input', () => updateCmdPopup(el));

        el.addEventListener('keydown', e => {
            if (cmdPopup.classList.contains('hidden')) return;
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                cmdIndex = (cmdIndex + 1) % cmdMatches.length;
                renderCmdPopup();
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                cmdIndex = (cmdIndex - 1 + cmdMatches.length) % cmdMatches.length;
                renderCmdPopup();
            } else if (e.key === 'Tab') {
                e.preventDefault();
                const pick = cmdIndex >= 0 ? cmdMatches[cmdIndex] : cmdMatches[0];
                if (pick) applyCmdItem(pick);
            } else if (e.key === 'Escape') {
                hideCmdPopup();
            }
        });

        el.addEventListener('blur', () => {
            // short delay so mousedown on popup fires first
            setTimeout(() => { if (document.activeElement !== el) hideCmdPopup(); }, 120);
        });
    }

    wireCmdPopup('input');

    let activeThread         = null;
    let isStreaming          = false;
    let activeThreadInternal = false; // true when viewing an internal model thread
    let activeEventSource    = null;  // prompt SSE stream connection
    let watchEventSource     = null;  // per-thread watch connection for server push

    // ── sidebar ─────────────────────────────────────────
    const sidebar   = document.getElementById('sidebar');
    const floatBtn  = document.getElementById('topbar-toggle');

    const overlay = document.getElementById('sidebar-overlay');
    const isMobile = () => window.innerWidth <= 640;

    function setSidebarCollapsed(collapsed) {
        if (isMobile()) {
            sidebar.classList.toggle('mobile-open', !collapsed);
            overlay.classList.toggle('visible', !collapsed);
            floatBtn.classList.toggle('visible', collapsed);
        } else {
            sidebar.classList.remove('mobile-open');
            overlay.classList.remove('visible');
            sidebar.classList.toggle('collapsed', collapsed);
            floatBtn.classList.toggle('visible', collapsed);
        }
    }

    overlay.addEventListener('click', () => setSidebarCollapsed(true));
    document.getElementById('btn-toggle-sidebar').addEventListener('click', () => setSidebarCollapsed(true));
    floatBtn.addEventListener('click', () => setSidebarCollapsed(false));

    // ── thread list ─────────────────────────────────────
    async function loadThreads() {
        try {
            const showInternal = document.getElementById('chk-show-internal').checked;
            const url = showInternal ? '/api/threads?includeInternal=true' : '/api/threads';
            const res = await fetch(url);
            const threads = await res.json();
            const list = document.getElementById('thread-list');

            // Preserve pending entries that haven't landed in the API yet
            const pendingEntries = [...list.querySelectorAll('li.pending')]
                .filter(li => !threads.some(t => t.key === li.dataset.key));

            list.innerHTML = '';

            // Re-inject preserved pending entries at the top
            pendingEntries.forEach(li => list.prepend(li));

            threads.forEach(t => {
                const li = document.createElement('li');
                li.dataset.key      = t.key;
                li.dataset.internal = t.isInternal ? '1' : '0';
                if (t.key === activeThread) li.classList.add('active');
                if (t.isInternal) li.classList.add('internal-thread');

                let label;
                if (t.isInternal) {
                    label = t.agentName ?? 'Internal';
                } else {
                    label = t.key.startsWith('web-') ? 'Web chat' : 'Discord';
                }

                const time = t.lastMessageAt && !t.lastMessageAt.startsWith('0001')
                    ? new Date(t.lastMessageAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
                    : '';

                li.innerHTML = `<span class="thread-time">${time}</span>${label}`;
                li.addEventListener('click', () => openThread(t.key, t.isInternal, t.agentName));
                list.appendChild(li);
            });
        } catch { /* silently ignore network hiccups during thread list refresh */ }
    }

    document.getElementById('chk-show-internal').addEventListener('change', loadThreads);

    document.getElementById('btn-new-chat').addEventListener('click', () => {
        if (watchEventSource)  { watchEventSource.close();  watchEventSource  = null; }
        if (activeEventSource) { activeEventSource.close(); activeEventSource = null; isStreaming = false; }
        activeThread = null;
        resetToIdle();
        renderAttachments([]);
        clearMsgAttachPreviews();
        document.getElementById('input').value = '';
        document.getElementById('input').style.height = 'auto';
        updateButtons();
    });

    // ── open thread ─────────────────────────────────────
    async function openThread(key, isInternal = false, agentName = null) {
        // Close any active prompt SSE stream.
        if (activeEventSource) { activeEventSource.close(); activeEventSource = null; isStreaming = false; updateButtons(); }
        // Close the previous thread's watch connection.
        if (watchEventSource) { watchEventSource.close(); watchEventSource = null; }
        watchHasRenderedResponse = false;

        activeThread         = key;
        activeThreadInternal = isInternal;

        document.querySelectorAll('#thread-list li').forEach(li =>
            li.classList.toggle('active', li.dataset.key === key));

        // Initial load
        await rebuildThread(key, isInternal, agentName);

        activateChat(document.getElementById('messages').children.length > 0);
        document.getElementById('input-area').style.display = isInternal ? 'none' : '';
        if (isMobile()) setSidebarCollapsed(true);
        if (!isInternal) document.getElementById('input').focus();

        // For internal threads use the poll; for dialogue threads open a watch connection.
        if (!isInternal) {
            openWatchConnection(key, agentName);
            // Sync attachment chips for this thread
            fetch(`/api/threads/${key}/attachments`)
                .then(r => r.json())
                .then(list => renderAttachments(list))
                .catch(() => renderAttachments([]));
        }
    }

    async function rebuildThread(key, isInternal = false, agentName = null) {
        const url   = isInternal ? `/api/threads/${key}/history?raw=true` : `/api/threads/${key}/history`;
        const res   = await fetch(url);
        const items = await res.json();

        // If the server has nothing yet but we're mid-stream, keep the optimistic
        // content in place — the next watch event will have real data to replace it.
        if (items.length === 0 && isStreaming) return;

        const box = document.getElementById('messages');
        // Preserve the typing indicator if it exists
        const typingEl = document.getElementById('typing-indicator');
        box.innerHTML = '';
        items.forEach(m => renderThreadItem(m, isInternal, agentName));
        // Re-add typing indicator after rebuild if ARI is still processing
        if (typingEl) box.appendChild(typingEl);

        scrollBottom();
    }

    // Shared flag: set to true when a watch rebuild has rendered the AriResponse,
    // so the concurrent stream handler knows not to append a duplicate row.
    let watchHasRenderedResponse = false;

    function openWatchConnection(key, agentName = null) {
        watchHasRenderedResponse = false;
        const es = new EventSource(`/api/threads/${key}/watch`);
        watchEventSource = es;

        es.onmessage = async e => {
            if (activeThread !== key) { es.close(); return; }
            try {
                const { isProcessing } = JSON.parse(e.data);
                await rebuildThread(key, false, agentName);
                // If a rebuild just rendered an AriResponse, signal the stream not to add another.
                const hasAriResponse = document.querySelector('.msg-row.assistant .bubble') !== null;
                if (hasAriResponse) watchHasRenderedResponse = true;
                // Show/hide typing indicator based on server processing state.
                if (isProcessing && !document.getElementById('typing-indicator')) showTyping();
                else if (!isProcessing) hideTyping();
            } catch { /* ignore malformed event */ }
        };

        es.onerror = () => {
            if (activeThread !== key) { es.close(); return; }
            // Connection dropped — reconnect after a short delay.
            es.close();
            watchEventSource = null;
            setTimeout(() => {
                if (activeThread === key && !activeThreadInternal)
                    openWatchConnection(key, agentName);
            }, 3000);
        };
    }

    // poll for internal thread updates (no watch SSE for those)
    async function pollInternalThread() {
        if (!activeThread || !activeThreadInternal) return;
        try {
            await rebuildThread(activeThread, true);
        } catch { /* silently ignore */ }
    }

    function buildMemoryBlock(changes, timeStr = '') {
        const row = document.createElement('div');
        row.className = 'msg-row memory-event';

        const changesHtml = (changes ?? []).map(c => {
            const titleHtml = c.url
                ? `<a href="${escHtml(c.url)}" target="_blank" rel="noopener" class="recall-note-link">${escHtml(c.title)}</a>`
                : escHtml(c.title);
            const detail = c.op === 'created'
                ? '<span class="memory-op memory-op-created">created</span>'
                : `<span class="memory-op memory-op-updated">updated</span> <span class="memory-summary">${escHtml(c.summary)}</span>`;
            return `<div class="memory-change">${titleHtml} — ${detail}</div>`;
        }).join('');

        row.innerHTML =
            `<details class="thought-block memory-block">` +
            `<summary>A·R·I will remember this</summary>` +
            `<div class="thought-content memory-content">${changesHtml}</div>` +
            `</details>` +
            (timeStr ? `<div class="msg-time">${timeStr}</div>` : '');
        return row;
    }


    // ── send ─────────────────────────────────────────────

    // Immediately injects a pending thread entry into the sidebar so it appears
    // as soon as the user sends — before ARI has responded.
    function injectPendingThread(key) {
        const list = document.getElementById('thread-list');
        // Remove any stale pending entry for this key first
        list.querySelector(`li[data-key="${key}"]`)?.remove();
        const li = document.createElement('li');
        li.dataset.key      = key;
        li.dataset.internal = '0';
        li.classList.add('active', 'pending');
        li.innerHTML = `<span class="thread-time">now</span>Web chat`;
        li.addEventListener('click', () => openThread(key));
        list.prepend(li);
    }

    async function send(prompt) {
        if (isStreaming || (!prompt && pendingMsgAttachments.length === 0)) return;
        setThreadPanelOpen(false);

        const needsNewThread = !activeThread;

        // For a new thread: activate the chat and show feedback immediately —
        // before the async thread-creation round trip so nothing feels sluggish.
        if (needsNewThread && !prompt.startsWith('/')) {
            activateChat();
            const optimisticAttachments = pendingMsgAttachments.length ? [...pendingMsgAttachments] : undefined;
            clearMsgAttachPreviews();
            renderThreadItem({ type: 'userMessage', content: prompt, timestamp: new Date().toISOString(), attachments: optimisticAttachments });
            isStreaming = true;
            updateButtons();
            showTyping();
            scrollBottom();
        }

        if (needsNewThread) {
            const res = await fetch('/api/threads', { method: 'POST' });
            const { key } = await res.json();
            activeThread = key;
            injectPendingThread(key);
            openWatchConnection(key);
        } else if (!document.getElementById('main').classList.contains('active')) {
            injectPendingThread(activeThread);
            activateChat();
        }

        // Slash commands go to the command API, not the LLM stream.
        // The watch SSE will push the CommandExchange back to this client when stored.
        if (prompt.startsWith('/')) {
            showTyping();
            try {
                const res = await fetch('/api/commands', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ threadKey: activeThread, input: prompt })
                });
                const data = await res.json();
                if (!res.ok) {
                    hideTyping();
                    renderThreadItem({ type: 'commandExchange', input: prompt,
                        response: data.error ?? 'Command failed.', timestamp: new Date().toISOString() });
                }
                // On success the watch SSE will trigger a rebuild which shows the CommandExchange.
            } catch {
                hideTyping();
                renderThreadItem({ type: 'commandExchange', input: prompt,
                    response: 'Command failed — could not reach A·R·I.', timestamp: new Date().toISOString() });
            }
            return;
        }

        // For existing threads, render user message and typing now (new threads did it above).
        if (!needsNewThread) {
            const optimisticAttachments = pendingMsgAttachments.length ? [...pendingMsgAttachments] : undefined;
            clearMsgAttachPreviews();
            renderThreadItem({ type: 'userMessage', content: prompt, timestamp: new Date().toISOString(), attachments: optimisticAttachments });
            scrollBottom();
            isStreaming = true;
            updateButtons();
            showTyping();
        }

        const threadKeyForThisStream = activeThread;
        const url = `/api/threads/${activeThread}/stream?prompt=${encodeURIComponent(prompt)}`;
        const es  = new EventSource(url);
        activeEventSource = es;

        let ariRow   = null;
        let bubbleEl = null;

        es.onmessage = e => {
            if (activeThread !== threadKeyForThisStream) { es.close(); activeEventSource = null; return; }
            if (e.data === '[DONE]') {
                es.close(); activeEventSource = null; isStreaming = false;
                updateButtons(); loadThreads();
                // The watch SSE will push a final rebuild with full metadata (ThinkingSeconds etc).
                // refreshLastAriRow is no longer needed — watch handles it.
                return;
            }
            if (e.data.startsWith('[ERROR]')) {
                hideTyping();
                renderThreadItem({ type: 'ariResponse', content: e.data.replace('[ERROR] ', ''), timestamp: new Date().toISOString() });
                es.close(); activeEventSource = null; isStreaming = false; updateButtons(); return;
            }
            // Skip stream rendering if the watch SSE already rebuilt the thread with the final response.
            if (watchHasRenderedResponse) return;
            if (!ariRow) {
                hideTyping();
                ariRow   = renderThreadItem({ type: 'ariResponse', content: '', timestamp: new Date().toISOString() });
                bubbleEl = ariRow?.querySelector('.bubble') ?? null;
            }
            if (bubbleEl) setBubbleMd(bubbleEl, e.data.replace(/\\n/g, '\n'));
            scrollBottom();
        };

        es.onerror = () => {
            if (activeThread !== threadKeyForThisStream) { es.close(); activeEventSource = null; return; }
            hideTyping();
            if (!ariRow) renderThreadItem({ type: 'ariResponse', content: '[connection error]', timestamp: new Date().toISOString() });
            es.close(); activeEventSource = null; isStreaming = false; updateButtons();
        };
    }

    document.getElementById('btn-send').addEventListener('click', () => {
        const el = document.getElementById('input');
        const t  = el.value.trim();
        if (!t) return;
        el.value = ''; el.style.height = 'auto';
        send(t);
    });

    // ── Thread item rendering ────────────────────────────────────────────────────

    function renderThreadItem(item, isInternal = false, agentName = null) {
        const box = document.getElementById('messages');
        const t   = item.timestamp
            ? new Date(item.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
            : '';

        let row = document.createElement('div');

        switch (item.type) {

            case 'userMessage': {
                if (isInternal) {
                    row.className = 'msg-row internal-prompt';
                    row.innerHTML = `<div class="sender">${escHtml(item.username)}</div><div class="bubble"></div><div class="msg-time">${t}</div>`;
                    setBubbleMd(row.querySelector('.bubble'), item.content);
                } else {
                    // Render each attachment as its own bubble before the text bubble.
                    (item.attachments ?? []).forEach(a => {
                        const attachRow = document.createElement('div');
                        if (a.isImage) {
                            // Use inline data URI for optimistic renders (content present client-side);
                            // use the server endpoint for history renders (content stripped from JSON).
                            const imgSrc = a.content
                                ? `data:${a.mimeType ?? 'image/jpeg'};base64,${a.content}`
                                : `/api/threads/${activeThread}/msg-attachment?name=${encodeURIComponent(a.name)}`;
                            attachRow.className = 'msg-row user attach-image';
                            attachRow.innerHTML =
                                `<div><img class="msg-image" src="${imgSrc}" alt="${escHtml(a.name)}" /><div class="msg-time">${t}</div></div>`;
                        } else {
                            attachRow.className = 'msg-row user attach-file';
                            attachRow.innerHTML =
                                `<div><div class="file-card">` +
                                `<div class="file-card-icon">${escHtml(fileExtLabel(a.name))}</div>` +
                                `<div class="file-card-name" title="${escHtml(a.name)}">${escHtml(a.name)}</div>` +
                                `</div><div class="msg-time">${t}</div></div>`;
                        }
                        box.appendChild(attachRow);
                    });
                    if (item.content) {
                        row.className = 'msg-row user';
                        row.innerHTML = `<div><div class="bubble"></div><div class="msg-time">${t}</div></div>`;
                        setBubbleMd(row.querySelector('.bubble'), item.content);
                    } else {
                        return (item.attachments?.length ? box.lastElementChild : null);
                    }
                }
                break;
            }

            case 'ariResponse': {
                row.className = 'msg-row assistant';
                let thoughtHtml = '';
                if (item.thinkingSeconds != null) {
                    const secs = typeof item.thinkingSeconds === 'number'
                        ? item.thinkingSeconds.toFixed(1) : item.thinkingSeconds;
                    let detailParts = '';
                    if (item.recallNotes) {
                        const noteBlocks = item.recallNotes.split(/\n(?=\[)/).map(block => {
                            const match = block.match(/^\[([^|\]]+)(?:\|([^\]]+))?\]\n?([\s\S]*)/);
                            return match ? { name: match[1], url: match[2] || null, content: match[3].trim() } : null;
                        }).filter(Boolean);
                        const notesHtml = noteBlocks.map(n => {
                            const nameHtml = n.url
                                ? `<a href="${escHtml(n.url)}" target="_blank" rel="noopener" class="recall-note-link">${escHtml(n.name)}</a>`
                                : escHtml(n.name);
                            return `<details class="recall-note"><summary>${nameHtml}</summary>` +
                                   `<div class="recall-note-content">${escHtml(n.content)}</div></details>`;
                        }).join('');
                        detailParts += `<div class="recall-notes-section"><span class="recall-label">Notes Read</span>${notesHtml}</div>`;
                    }
                    if (item.contextSummary) detailParts += `<h4>Context summary</h4>${escHtml(item.contextSummary)}`;
                    const hasDetails = detailParts.length > 0;
                    thoughtHtml = hasDetails
                        ? `<details class="thought-block"><summary>A·R·I thought for ${secs}s</summary>` +
                          `<div class="thought-content">${detailParts}</div></details>`
                        : `<div style="font-size:12px;color:#8e8ea0;margin-bottom:4px;user-select:none;">A·R·I thought for ${secs}s</div>`;
                }
                const senderLabel = isInternal ? escHtml(agentName ?? 'Agent') : 'A·R·I';
                row.innerHTML =
                    `<div class="sender">${senderLabel}</div>` +
                    thoughtHtml +
                    `<div class="bubble"></div>` +
                    `<div class="msg-time">${t}</div>`;
                setBubbleMd(row.querySelector('.bubble'), item.content);
                break;
            }

            case 'commandExchange': {
                row.className = 'msg-row command-exchange';
                row.innerHTML =
                    `<div class="command-input">${escHtml(item.input)}</div>` +
                    `<div class="command-response-block"></div>` +
                    `<div class="msg-time">${t}</div>`;
                setBubbleMd(row.querySelector('.command-response-block'), item.response);
                break;
            }

            case 'engramEvent': {
                row = buildMemoryBlock(item.changes, t);
                break;
            }

            default: {
                // Unknown type — skip silently
                return null;
            }
        }

        box.appendChild(row);
        suppressPreviousTimestamp(box, row);
        return row;
    }

    // If the new row is same-side and same minute as its predecessor, hide the predecessor's timestamp.
    function suppressPreviousTimestamp(box, newRow) {
        const sideClass = newRow.classList.contains('user') || newRow.classList.contains('attach-image') || newRow.classList.contains('attach-file') ? 'user' : 'assistant';
        const newTime   = newRow.querySelector('.msg-time')?.textContent?.trim();
        if (!newTime) return;

        // Walk backwards to find the previous visible message row of the same side.
        let prev = newRow.previousElementSibling;
        while (prev) {
            const isUser = prev.classList.contains('user') || prev.classList.contains('attach-image') || prev.classList.contains('attach-file');
            const isAsst = prev.classList.contains('assistant');
            const prevSide = isUser ? 'user' : isAsst ? 'assistant' : null;
            if (!prevSide) { prev = prev.previousElementSibling; continue; }
            if (prevSide !== sideClass) break;

            const prevTimeEl = prev.querySelector('.msg-time');
            if (prevTimeEl && prevTimeEl.textContent.trim() === newTime)
                prevTimeEl.style.display = 'none';
            break;
        }
    }


    // ── Toast notifications ───────────────────────────────
    function showToast(message) {
        const t = document.createElement('div');
        t.className = 'toast';
        t.textContent = message;
        document.body.appendChild(t);
        requestAnimationFrame(() => t.classList.add('toast-visible'));
        setTimeout(() => {
            t.classList.remove('toast-visible');
            t.addEventListener('transitionend', () => t.remove());
        }, 4000);
    }

    function escHtml(str) {
        return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    const COPY_ICON = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
    const CHECK_ICON = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;

    function attachCopyButtons(el) {
        el.querySelectorAll('.code-block').forEach(wrapper => {
            if (wrapper.querySelector('.code-header')) return;
            const pre = wrapper.querySelector('pre');
            if (!pre) return;

            // Extract language from class e.g. "language-python"
            const codeEl = pre.querySelector('code');
            const langClass = codeEl?.className.match(/language-(\S+)/);
            const lang = langClass ? langClass[1] : '';

            // Syntax highlight
            if (codeEl && lang) hljs.highlightElement(codeEl);

            // Build header
            const header = document.createElement('div');
            header.className = 'code-header';

            const langSpan = document.createElement('span');
            langSpan.className = 'code-lang';
            langSpan.textContent = lang || 'code';

            const btn = document.createElement('button');
            btn.className = 'code-copy-btn';
            btn.title = 'Copy code';
            btn.innerHTML = COPY_ICON;
            btn.addEventListener('click', () => {
                const text = codeEl?.innerText ?? pre.innerText;
                navigator.clipboard.writeText(text).then(() => {
                    btn.innerHTML = CHECK_ICON;
                    btn.classList.add('copied');
                    setTimeout(() => { btn.innerHTML = COPY_ICON; btn.classList.remove('copied'); }, 2000);
                });
            });

            header.appendChild(langSpan);
            header.appendChild(btn);
            wrapper.insertBefore(header, pre);
        });
    }

    function renderMd(content) {
        const html = marked.parse(content ?? '', { breaks: true, gfm: true });
        const tmp = document.createElement('div');
        tmp.innerHTML = html;
        tmp.querySelectorAll('pre').forEach(pre => {
            const wrapper = document.createElement('div');
            wrapper.className = 'code-block';
            pre.parentNode.insertBefore(wrapper, pre);
            wrapper.appendChild(pre);
        });
        return tmp.innerHTML;
    }

    function setBubbleMd(el, content) {
        el.innerHTML = renderMd(content);
        attachCopyButtons(el);
    }

    function showTyping() {
        const box = document.getElementById('messages');
        const row = document.createElement('div');
        row.className = 'msg-row assistant';
        row.id = 'typing-indicator';
        row.innerHTML =
            `<div class="sender">A·R·I</div>` +
            `<div class="typing-indicator">` +
            `<span>A·R·I is thinking</span>` +
            `<div class="typing-dots"><b></b><b></b><b></b></div>` +
            `</div>`;
        box.appendChild(row);
        scrollBottom();
    }

    function hideTyping() {
        document.getElementById('typing-indicator')?.remove();
    }

    function scrollBottom() {
        const box = document.getElementById('messages');
        box.scrollTop = box.scrollHeight;
    }

    function updateButtons() {
        const chatText = document.getElementById('input').value.trim();
        document.getElementById('btn-send').disabled = isStreaming || (!chatText && pendingMsgAttachments.length === 0);
    }

    // ── auto-resize + keydown for all textareas ──────────
    function wireTextarea(id, sendFn) {
        const el = document.getElementById(id);
        el.addEventListener('input', function () {
            this.style.height = 'auto';
            this.style.height = Math.min(this.scrollHeight, 180) + 'px';
            updateButtons();
        });
        el.addEventListener('keydown', function (e) {
            const isMobile = window.matchMedia('(pointer: coarse)').matches;
            if (e.key === 'Enter' && !e.shiftKey && !isMobile) { e.preventDefault(); sendFn(); }
        });
    }

    document.getElementById('input-wrap').addEventListener('click', function (e) {
        if (!e.target.closest('button')) document.getElementById('input').focus();
    });

    // ── Message-scoped attachment state ──────────────────
    let pendingMsgAttachments = []; // { name, isImage, mimeType, content }

    function fileExtLabel(name) {
        const dot = name.lastIndexOf('.');
        return dot >= 0 ? name.slice(dot + 1).toUpperCase().slice(0, 4) : 'FILE';
    }

    function renderMsgAttachPreviews() {
        const preview = document.getElementById('msg-attach-preview');
        preview.innerHTML = '';
        pendingMsgAttachments.forEach(a => {
            const chip = document.createElement('div');
            chip.className = 'msg-attach-chip' + (a.uploading ? ' uploading' : '');

            const icon = a.uploading
                ? `<div class="chip-file-icon chip-uploading-icon">…</div>`
                : a.isImage
                    ? `<img src="data:${a.mimeType};base64,${a.content}" alt="${escHtml(a.name)}">`
                    : `<div class="chip-file-icon">${escHtml(fileExtLabel(a.name))}</div>`;

            const label = a.uploading ? 'Uploading…' : a.name;

            chip.innerHTML =
                icon +
                `<span class="chip-name" title="${escHtml(a.name)}">${escHtml(label)}</span>` +
                (a.uploading ? '' : `<button class="chip-remove" title="Remove">×</button>`);

            if (!a.uploading)
                chip.querySelector('.chip-remove').addEventListener('click', () => removeMessageAttachment(a.name));
            preview.appendChild(chip);
        });
    }

    async function uploadMessageFiles(files) {
        if (!activeThread) {
            const res = await fetch('/api/threads', { method: 'POST' });
            const { key } = await res.json();
            activeThread = key;
            openWatchConnection(key);
        }
        // Show uploading placeholders immediately
        for (const file of files) {
            pendingMsgAttachments = pendingMsgAttachments.filter(a => a.name !== file.name);
            pendingMsgAttachments.push({ name: file.name, isImage: false, mimeType: null, content: null, uploading: true });
        }
        renderMsgAttachPreviews();
        updateButtons();

        for (const file of files) {
            const fd = new FormData();
            fd.append('file', file);
            const res = await fetch(`/api/threads/${activeThread}/message-attachments`, { method: 'POST', body: fd });
            if (res.ok) {
                const data = await res.json();
                pendingMsgAttachments = pendingMsgAttachments.filter(a => a.name !== data.name);
                pendingMsgAttachments.push({ name: data.name, isImage: data.isImage, mimeType: data.mimeType, content: data.content, uploading: false });
            } else {
                pendingMsgAttachments = pendingMsgAttachments.filter(a => a.name !== file.name);
                const err = await res.json().catch(() => null);
                showToast(err?.error ?? `Could not attach ${file.name}.`);
            }
            renderMsgAttachPreviews();
            updateButtons();
        }
    }

    async function removeMessageAttachment(name) {
        if (!activeThread) return;
        await fetch(`/api/threads/${activeThread}/message-attachments/${encodeURIComponent(name)}`, { method: 'DELETE' });
        pendingMsgAttachments = pendingMsgAttachments.filter(a => a.name !== name);
        renderMsgAttachPreviews();
        updateButtons();
    }

    function clearMsgAttachPreviews() {
        pendingMsgAttachments = [];
        renderMsgAttachPreviews();
    }

    // ── Thread-pin animations ─────────────────────────────
    function flyToThreadPanel(name) {
        const btn = document.getElementById('btn-open-thread-panel');
        const main = document.getElementById('main');
        const startRect = main.getBoundingClientRect();
        const endRect   = btn.getBoundingClientRect();

        const startX = startRect.left + startRect.width  / 2;
        const startY = startRect.top  + startRect.height / 2;
        const endX   = endRect.left   + endRect.width    / 2;
        const endY   = endRect.top    + endRect.height   / 2;

        const el = document.createElement('div');
        el.className = 'attach-fly';
        el.innerHTML =
            `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">` +
            `<line x1="12" y1="17" x2="12" y2="3"/><polyline points="8 7 12 3 16 7"/>` +
            `<path d="M20 21H4"/><line x1="17" y1="14" x2="17" y2="21"/><line x1="7" y1="14" x2="7" y2="21"/></svg>` +
            escHtml(name.length > 28 ? name.slice(0, 26) + '…' : name);
        el.style.left = `${startX - 80}px`;
        el.style.top  = `${startY - 18}px`;
        el.style.setProperty('--fly-x', `${endX - startX + 80}px`);
        el.style.setProperty('--fly-y', `${endY - startY + 18}px`);
        document.body.appendChild(el);
        el.addEventListener('animationend', () => el.remove());
    }

    function bounceThreadPanel() {
        const panel = document.getElementById('thread-panel');
        if (panel.classList.contains('open')) return;
        panel.classList.remove('panel-peek');
        void panel.offsetWidth;
        panel.classList.add('panel-peek');
        panel.addEventListener('animationend', () => panel.classList.remove('panel-peek'), { once: true });
    }

    function renderPinNotice(name) {
        const box = document.getElementById('messages');
        if (!box) return;
        const row = document.createElement('div');
        row.className = 'msg-row thread-pin-notice';
        row.innerHTML =
            `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">` +
            `<line x1="12" y1="17" x2="12" y2="3"/><polyline points="8 7 12 3 16 7"/>` +
            `<path d="M20 21H4"/><line x1="17" y1="14" x2="17" y2="21"/><line x1="7" y1="14" x2="7" y2="21"/></svg>` +
            `<span><strong>${escHtml(name)}</strong> added to thread context</span>`;
        box.appendChild(row);
        scrollBottom();
    }

    // ── Thread panel (right sidebar) ──────────────────────
    const threadPanel  = document.getElementById('thread-panel');
    const attachList   = document.getElementById('attachment-list');
    const fileInput    = document.getElementById('file-input');

    const btnOpenThreadPanel = document.getElementById('btn-open-thread-panel');

    function setThreadPanelOpen(open) {
        threadPanel.classList.toggle('open', open);
        btnOpenThreadPanel.classList.toggle('hidden', open);
    }

    function renderAttachments(items) {
        attachList.innerHTML = '';
        if (!items.length) {
            attachList.innerHTML = '<li class="attachment-empty">No attachments</li>';
            return;
        }
        items.forEach(({ name }) => {
            const li = document.createElement('li');
            li.innerHTML = `<span class="attachment-item-name" title="${name}">${name}</span>
                <button class="attachment-item-remove" title="Remove">×</button>`;
            li.querySelector('.attachment-item-remove').addEventListener('click', () => removeAttachment(name));
            attachList.appendChild(li);
        });
    }

    async function refreshAttachments() {
        if (!activeThread) { renderAttachments([]); return; }
        const res  = await fetch(`/api/threads/${activeThread}/attachments`).catch(() => null);
        const list = res?.ok ? await res.json() : [];
        renderAttachments(list);
    }

    async function removeAttachment(name) {
        if (!activeThread) return;
        await fetch(`/api/threads/${activeThread}/attachments/${encodeURIComponent(name)}`, { method: 'DELETE' });
        await refreshAttachments();
    }

    async function uploadFiles(files) {
        if (!activeThread) {
            const res = await fetch('/api/threads', { method: 'POST' });
            const { key } = await res.json();
            activeThread = key;
            injectPendingThread(key);
            activateChat();
            openWatchConnection(key);
        }
        const succeeded = [];
        for (const file of files) {
            const fd = new FormData();
            fd.append('file', file);
            const res = await fetch(`/api/threads/${activeThread}/attachments`, { method: 'POST', body: fd });
            if (res.ok) {
                succeeded.push(file.name);
            } else {
                const err = await res.json().catch(() => null);
                showToast(err?.error ?? `Could not attach ${file.name}.`);
            }
        }
        if (succeeded.length) {
            succeeded.forEach((name, i) => setTimeout(() => flyToThreadPanel(name), i * 120));
            setTimeout(() => {
                bounceThreadPanel();
                succeeded.forEach(name => renderPinNotice(name));
            }, succeeded.length * 120 + 400);
        }
        await refreshAttachments();
    }

    const msgFileInput    = document.createElement('input');
    msgFileInput.type     = 'file';
    msgFileInput.multiple = true;
    msgFileInput.style.display = 'none';
    document.body.appendChild(msgFileInput);

    // Paperclip in the input area → message attachment
    document.getElementById('btn-attach').addEventListener('click', () => msgFileInput.click());
    msgFileInput.addEventListener('change', async () => {
        if (msgFileInput.files.length) await uploadMessageFiles([...msgFileInput.files]);
        msgFileInput.value = '';
    });

    // Thread panel attach button → thread attachment
    document.getElementById('btn-attach-panel').addEventListener('click', () => fileInput.click());
    document.getElementById('btn-close-thread-panel').addEventListener('click', () => setThreadPanelOpen(false));
    btnOpenThreadPanel.addEventListener('click', () => setThreadPanelOpen(true));
    fileInput.addEventListener('change', () => { if (fileInput.files.length) uploadFiles([...fileInput.files]); fileInput.value = ''; });

    // ── Drag-drop (document-level) ────────────────────────
    const dropOverlay   = document.getElementById('drop-overlay');
    const dropZoneMsg   = document.getElementById('drop-zone-message');
    const dropZoneThread = document.getElementById('drop-zone-thread');
    let dragCounter = 0;

    document.addEventListener('dragenter', e => {
        if (!e.dataTransfer?.types?.includes('Files')) return;
        e.preventDefault(); dragCounter++;
        dropOverlay.style.display = 'flex';
    });
    document.addEventListener('dragleave', () => {
        dragCounter--;
        if (dragCounter <= 0) {
            dragCounter = 0;
            dropOverlay.style.display = 'none';
            dropZoneMsg.classList.remove('drag-over');
            dropZoneThread.classList.remove('drag-over');
        }
    });
    document.addEventListener('dragover', e => {
        if (e.dataTransfer?.types?.includes('Files')) e.preventDefault();
    });

    function hideDrop() {
        dragCounter = 0;
        dropOverlay.style.display = 'none';
        dropZoneMsg.classList.remove('drag-over');
        dropZoneThread.classList.remove('drag-over');
    }

    dropZoneThread.addEventListener('dragover',  e => e.preventDefault());
    dropZoneMsg.addEventListener('dragover',     e => e.preventDefault());
    dropZoneThread.addEventListener('dragenter', e => { e.preventDefault(); dropZoneThread.classList.add('drag-over'); dropZoneMsg.classList.remove('drag-over'); });
    dropZoneMsg.addEventListener('dragenter',    e => { e.preventDefault(); dropZoneMsg.classList.add('drag-over'); dropZoneThread.classList.remove('drag-over'); });

    dropZoneThread.addEventListener('drop', async e => {
        e.preventDefault(); e.stopPropagation();
        const files = [...(e.dataTransfer.files ?? [])];
        hideDrop();
        if (files.length) await uploadFiles(files);
    });
    dropZoneMsg.addEventListener('drop', async e => {
        e.preventDefault(); e.stopPropagation();
        const files = [...(e.dataTransfer.files ?? [])];
        hideDrop();
        if (files.length) await uploadMessageFiles(files);
    });
    document.addEventListener('drop', e => {
        e.preventDefault();
        hideDrop();
    });

    // ── Paste images into textarea ────────────────────────
    document.getElementById('input').addEventListener('paste', async e => {
        const items = [...(e.clipboardData?.items ?? [])];
        const imageItems = items.filter(i => i.kind === 'file' && i.type.startsWith('image/'));
        if (!imageItems.length) return;
        e.preventDefault();
        const files = imageItems.map(i => i.getAsFile()).filter(Boolean);
        if (files.length) await uploadMessageFiles(files);
    });

    wireTextarea('input', () => {
        const el = document.getElementById('input');
        const t  = el.value.trim(); if (!t) return;
        el.value = ''; el.style.height = 'auto'; send(t);
    });

    // ── wait for ARI to be ready (polls /api/threads until not 503) ──
    async function waitForReady() {
        const logo = document.getElementById('main-logo');
        while (true) {
            const res = await fetch('/api/threads').catch(() => null);
            if (res && res.status !== 503) {
                if (logo) logo.style.opacity = '1';
                await loadThreads();
                return;
            }
            if (logo) logo.style.opacity = '0.4';
            await new Promise(r => setTimeout(r, 2000));
        }
    }

    // ── init ─────────────────────────────────────────────
    (async () => {
        try {
            await waitForReady();
            const initial = '@Html.Raw(Model ?? "")';
            if (initial) openThread(initial);
            setInterval(loadThreads, 5000);
            setInterval(pollInternalThread, 3000);
        } catch (err) {
            console.error('ARI init failed:', err);
            setTimeout(() => location.reload(), 2000);
        }
    })();
</script>
}

const vsDropzone   = document.getElementById('vs-dropzone');
const vsFileInput  = document.getElementById('vs-file-input');
const vsFileList   = document.getElementById('vs-file-list');
const vsFileItems  = document.getElementById('vs-file-items');
const vsFileCount  = document.getElementById('vs-file-count');
const vsClearBtn   = document.getElementById('vs-clear-files');
const vsBrowseBtn  = document.getElementById('vs-browse-btn');
const vsModelName  = document.getElementById('vs-model-name');
const vsEpochs     = document.getElementById('vs-epochs');
const vsSaveFreq   = document.getElementById('vs-save-freq');
const vsTrainBtn   = document.getElementById('vs-train-btn');
const vsProgSec      = document.getElementById('vs-progress-section');
const vsStepLabel    = document.getElementById('vs-step-label');
const vsPctLabel     = document.getElementById('vs-pct-label');
const vsProgFill     = document.getElementById('vs-progress-fill');
const vsElapsedLabel = document.getElementById('vs-elapsed-label');
const vsEtaLabel     = document.getElementById('vs-eta-label');
const vsDetail       = document.getElementById('vs-detail-label');
const vsLogLines     = document.getElementById('vs-log-lines');
const vsLogBadge     = document.getElementById('vs-log-badge');

let vsFiles = [];
let vsProgressEs  = null;
let vsStartTime   = null;   // Date when training (upload+train) started
let vsLastPct     = 0;      // most recent non-zero progress percent
let vsTimerHandle = null;   // setInterval handle for the clock

function fmtDuration(secs) {
    secs = Math.round(secs);
    if (secs < 60)  return secs + 's';
    if (secs < 3600) return Math.floor(secs/60) + 'm ' + (secs%60) + 's';
    const h = Math.floor(secs/3600), m = Math.floor((secs%3600)/60);
    return h + 'h ' + m + 'm';
}

function vsTickTimer() {
    if (!vsStartTime) return;
    const elapsed = (Date.now() - vsStartTime) / 1000;
    vsElapsedLabel.textContent = 'Elapsed: ' + fmtDuration(elapsed);
    if (vsLastPct > 0 && vsLastPct < 100) {
        const totalEst = elapsed / (vsLastPct / 100);
        const remaining = Math.max(0, totalEst - elapsed);
        vsEtaLabel.textContent = 'ETA: ~' + fmtDuration(remaining);
    } else if (vsLastPct === 0) {
        vsEtaLabel.textContent = 'ETA: —';
    }
}

function vsStartTimer() {
    vsStartTime = Date.now();
    vsLastPct   = 0;
    vsElapsedLabel.textContent = 'Elapsed: 0s';
    vsEtaLabel.textContent     = 'ETA: —';
    if (vsTimerHandle) clearInterval(vsTimerHandle);
    vsTimerHandle = setInterval(vsTickTimer, 1000);
}

function vsStopTimer() {
    if (vsTimerHandle) { clearInterval(vsTimerHandle); vsTimerHandle = null; }
    vsTickTimer(); // final snapshot
    vsEtaLabel.textContent = 'ETA: done';
}


// ── File selection ────────────────────────────────────────
function fmtBytes(b) { return b > 1048576 ? (b/1048576).toFixed(1)+' MB' : (b/1024).toFixed(0)+' KB'; }

function renderFiles() {
    vsFileItems.innerHTML = '';
    vsFiles.forEach(f => {
        const el = document.createElement('div');
        el.className = 'vs-file-item';
        el.innerHTML = `<span class="vs-file-name">${escHtml(f.name)}</span><span class="vs-file-size">${fmtBytes(f.size)}</span>`;
        vsFileItems.appendChild(el);
    });
    vsFileCount.textContent = `${vsFiles.length} file${vsFiles.length !== 1 ? 's' : ''} selected`;
    vsFileList.style.display = vsFiles.length ? '' : 'none';
    vsDropzone.style.display = vsFiles.length ? 'none' : '';
}

function addFiles(fileList) {
    const allowed = new Set(['.wav','.mp3','.flac','.ogg']);
    const newFiles = Array.from(fileList).filter(f => {
        const ext = f.name.slice(f.name.lastIndexOf('.')).toLowerCase();
        return allowed.has(ext);
    });
    vsFiles = [...vsFiles, ...newFiles];
    renderFiles();
}

vsBrowseBtn.addEventListener('click', () => vsFileInput.click());
vsFileInput.addEventListener('change', () => { addFiles(vsFileInput.files); vsFileInput.value = ''; });
vsClearBtn.addEventListener('click', () => { vsFiles = []; renderFiles(); });

vsDropzone.addEventListener('dragover', e => { e.preventDefault(); vsDropzone.classList.add('drag-over'); });
vsDropzone.addEventListener('dragleave', () => vsDropzone.classList.remove('drag-over'));
vsDropzone.addEventListener('drop', e => {
    e.preventDefault();
    vsDropzone.classList.remove('drag-over');
    addFiles(e.dataTransfer.files);
});

// ── Training ──────────────────────────────────────────────
function vsAppendLog(text, cls = '') {
    const el = document.createElement('div');
    el.className = 'log-line ' + (cls || classifyLog(text));
    el.textContent = text;
    vsLogLines.appendChild(el);
    while (vsLogLines.children.length > 500) vsLogLines.removeChild(vsLogLines.firstChild);
    vsLogLines.scrollTop = vsLogLines.scrollHeight;
}

function vsSetProgress(step, pct, detail, state) {
    vsStepLabel.textContent = step;
    vsPctLabel.textContent  = pct + '%';
    vsProgFill.style.width  = pct + '%';
    vsProgFill.className    = 'vs-progress-fill' + (state === 'done' ? ' done' : state === 'error' ? ' error' : '');
    vsDetail.textContent    = detail || '';
    if (pct > 0) vsLastPct = pct;
}

vsTrainBtn.addEventListener('click', async () => {
    if (!vsFiles.length) { alert('Please select at least one audio file.'); return; }
    const modelName = vsModelName.value.trim();
    if (!modelName) { alert('Please enter a model name.'); return; }

    vsTrainBtn.disabled = true;
    vsProgSec.style.display = '';
    vsLogLines.innerHTML = '';
    vsLogBadge.textContent = 'uploading…';
    vsSetProgress('Uploading files', 0, null, '');
    vsStartTimer();

    try {
        // 1 — Create staging folder
        const stageResp = await fetch('/api/cp/voice/stage', { method: 'POST' });
        if (!stageResp.ok) throw new Error('Stage failed: ' + (await stageResp.text()));
        const { stageId, stagingPath } = await stageResp.json();

        // 2 — Upload each file in 5 MB chunks, 4 at a time in parallel
        const CHUNK       = 5 * 1024 * 1024; // 5 MB
        const CONCURRENCY = 4;
        for (let fi = 0; fi < vsFiles.length; fi++) {
            const f           = vsFiles[fi];
            const totalChunks = Math.max(1, Math.ceil(f.size / CHUNK));
            vsAppendLog(`Uploading ${f.name} (${fmtBytes(f.size)}, ${totalChunks} chunk${totalChunks>1?'s':''})…`);

            let done = 0;
            const uploadChunk = async (ci) => {
                const slice = f.slice(ci * CHUNK, Math.min((ci + 1) * CHUNK, f.size));
                const url   = `/api/cp/voice/upload`
                    + `?stageId=${encodeURIComponent(stageId)}`
                    + `&name=${encodeURIComponent(f.name)}`
                    + `&chunk=${ci}&totalChunks=${totalChunks}`;
                const up = await fetch(url, {
                    method:  'POST',
                    body:    slice,
                    headers: { 'Content-Type': 'application/octet-stream' },
                });
                if (!up.ok) throw new Error(`Upload of ${f.name} chunk ${ci} failed: ` + (await up.text()));
                done++;
                vsSetProgress(
                    `Uploading file ${fi+1} of ${vsFiles.length}`,
                    Math.round((done / totalChunks) * 100),
                    `${f.name} — ${done} / ${totalChunks} chunks`,
                    ''
                );
            };

            // Run chunks in batches of CONCURRENCY
            for (let ci = 0; ci < totalChunks; ci += CONCURRENCY) {
                const batch = Array.from({ length: Math.min(CONCURRENCY, totalChunks - ci) }, (_, i) => uploadChunk(ci + i));
                await Promise.all(batch);
            }
            vsAppendLog(`✓ ${f.name} uploaded`);
        }
        vsAppendLog(`All ${vsFiles.length} file(s) uploaded.`);

        // 2 — Start training
        vsLogBadge.textContent = 'training…';
        vsLogBadge.classList.add('live');
        const trainResp = await fetch('/api/cp/voice/train', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                modelName,
                stagingPath,
                epochs:        +vsEpochs.value,
                saveEveryNEpochs: +vsSaveFreq.value,
            })
        });
        if (!trainResp.ok) throw new Error('Start failed: ' + (await trainResp.text()));

        // 3 — Stream progress (auto-reconnects if Cloudflare drops the SSE connection)
        let vsDone = false;
        function connectProgressSse() {
            if (vsDone) return;
            if (vsProgressEs) vsProgressEs.close();
            vsProgressEs = new EventSource('/api/cp/voice/progress');
            vsLogBadge.textContent = 'live';
            vsLogBadge.classList.add('live');

            vsProgressEs.onmessage = e => {
                try {
                    const d = JSON.parse(e.data);
                    vsSetProgress(d.step, d.percent, d.detail, d.done ? (d.success ? 'done' : 'error') : '');
                    if (d.detail) vsAppendLog(d.detail, d.step === 'Error' ? 'log-error' : '');
                    if (d.done) {
                        vsDone = true;
                        vsProgressEs.close();
                        vsStopTimer();
                        vsLogBadge.textContent = d.success ? 'done ✓' : 'failed';
                        vsLogBadge.classList.remove('live');
                        vsTrainBtn.disabled = false;
                        if (d.success) vsAppendLog(`✓ Training complete! Model: ${modelName}.pth`);
                        if (d.error)   vsAppendLog(`Error: ${d.error}`, 'log-error');
                    }
                } catch { /* ignore parse errors / SSE comments */ }
            };
            vsProgressEs.onerror = () => {
                if (vsDone) return;
                vsLogBadge.textContent = 'reconnecting…';
                vsLogBadge.classList.remove('live');
                vsProgressEs.close();
                setTimeout(connectProgressSse, 3000); // retry after 3 s
            };
        }
        connectProgressSse();

    } catch (err) {
        vsStopTimer();
        vsAppendLog('Error: ' + err.message, 'log-error');
        vsLogBadge.textContent = 'failed';
        vsLogBadge.classList.remove('live');
        vsTrainBtn.disabled = false;
    }
});

// ── Test Voice ────────────────────────────────────────────
const tvText     = document.getElementById('tv-text');
const tvModel    = document.getElementById('tv-model');
const tvSpeakBtn = document.getElementById('tv-speak-btn');
const tvStatus   = document.getElementById('tv-status');

async function loadVoiceModels() {
    try {
        const [modelsResp, activeResp] = await Promise.all([
            fetch('/api/cp/voice/models'),
            fetch('/api/cp/voice/active'),
        ]);
        const { models } = await modelsResp.json();
        const { model: activeModel, ready } = await activeResp.json();

        tvModel.innerHTML = models.length
            ? models.map(m => `<option value="${escHtml(m)}"${m === activeModel ? ' selected' : ''}>${escHtml(m)}${m === activeModel ? ' ✓' : ''}</option>`).join('')
            : '<option value="">No models found</option>';

        tvStatus.textContent = ready ? `Active: ${activeModel}` : 'Voice module not running';
    } catch {
        tvModel.innerHTML = '<option value="">Failed to load</option>';
    }
}
loadVoiceModels();

tvSpeakBtn.addEventListener('click', async () => {
    const text      = tvText.value.trim();
    const modelName = tvModel.value;
    if (!text) return;
    tvSpeakBtn.disabled  = true;
    tvStatus.textContent = 'Synthesising…';

    // Create AudioContext during the click gesture so playback is unlocked after the async fetch
    const audioCtx = new AudioContext();

    try {
        const resp = await fetch('/api/cp/voice/speak', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ text, modelName }),
        });
        if (!resp.ok) {
            const err = await resp.json().catch(() => ({ error: resp.statusText }));
            tvStatus.textContent = 'Error: ' + (err.error ?? resp.statusText);
        } else {
            const arrayBuffer = await resp.arrayBuffer();
            const audioBuffer = await audioCtx.decodeAudioData(arrayBuffer);
            const source      = audioCtx.createBufferSource();
            source.buffer     = audioBuffer;
            source.connect(audioCtx.destination);
            source.start();
            tvStatus.textContent = '';
        }
    } catch (err) {
        tvStatus.textContent = 'Error: ' + err.message;
    } finally {
        tvSpeakBtn.disabled = false;
    }
});

tvText.addEventListener('keydown', e => { if (e.key === 'Enter') tvSpeakBtn.click(); });

</script>
}

@{
    Layout = "_Layout";
    ViewData["Title"] = "Control Panel — A·R·I";
}

<div id="shell">

    <!-- sidebar -->
    <aside id="sidebar">
        <div id="sidebar-inner">
            <div id="sidebar-header">
                <img id="sidebar-wordmark" src="/images/logo-white.png?v=2" alt="A·R·I" />
                <button id="btn-toggle-sidebar" title="Close sidebar">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/>
                    </svg>
                </button>
            </div>

            <a id="btn-back" href="/">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
                Back
            </a>

            <div id="cp-sidebar-nav">
                <div class="cp-nav-item active" data-tab="overview">Overview</div>
                <div class="cp-nav-item" data-tab="voice">Voice Synthesis</div>
            </div>
        </div>
    </aside>

    <div id="sidebar-overlay"></div>

    <button id="topbar-toggle" title="Open sidebar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/>
        </svg>
    </button>

    <div id="main" class="cp-main">

        <div id="cp-header">
            <img id="cp-logo" src="/images/logo-black.png?v=2" alt="A·R·I" />
            <span id="cp-title">Overview</span>
        </div>

        <!-- ── Voice Synthesis tab ──────────────────────────────────── -->
        <div id="tab-voice" class="cp-tab" style="display:none;flex:1;overflow-y:auto;padding:24px 28px;">

            <div class="vs-section">
                <div class="vs-section-title">Train a Voice Model</div>

                <!-- Drop zone -->
                <div id="vs-dropzone" class="vs-dropzone">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="opacity:.4"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                    <p>Drag &amp; drop audio files here<br><span style="font-size:12px;color:var(--text-dim)">.wav, .mp3, .flac, .ogg</span></p>
                    <button class="vs-btn-outline" id="vs-browse-btn" type="button">Browse files</button>
                    <input type="file" id="vs-file-input" multiple accept=".wav,.mp3,.flac,.ogg" style="display:none" />
                </div>

                <!-- File list -->
                <div id="vs-file-list" style="display:none">
                    <div class="vs-file-list-header">
                        <span id="vs-file-count">0 files selected</span>
                        <button class="vs-btn-text" id="vs-clear-files" type="button">Clear</button>
                    </div>
                    <div id="vs-file-items"></div>
                </div>
            </div>

            <!-- Settings -->
            <div class="vs-section">
                <div class="vs-section-title">Training settings</div>
                <div class="vs-form-grid" style="grid-template-columns:1fr 1fr 1fr;">
                    <label class="vs-label">
                        Model name
                        <input type="text" id="vs-model-name" class="vs-input" placeholder="e.g. Voice" autocomplete="off" />
                    </label>
                    <label class="vs-label">
                        Epochs
                        <input type="number" id="vs-epochs" class="vs-input" value="100" min="1" max="1000" />
                    </label>
                    <label class="vs-label">
                        Save every N epochs
                        <input type="number" id="vs-save-freq" class="vs-input" value="10" min="1" max="100" />
                    </label>
                </div>
                <button class="vs-btn-primary" id="vs-train-btn" type="button">Train</button>
            </div>

            <!-- Test Voice -->
            <div class="vs-separator"></div>
            <div class="vs-section">
                <div class="vs-section-title">Test Voice</div>
                <div style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap">
                    <label class="vs-label" style="flex:1;min-width:180px">
                        Text
                        <input type="text" id="tv-text" class="vs-input" placeholder="Type something to say…" autocomplete="off" />
                    </label>
                    <label class="vs-label" style="min-width:140px">
                        Voice model
                        <select id="tv-model" class="vs-input"></select>
                    </label>
                    <button class="vs-btn-primary" id="tv-speak-btn" type="button">Speak</button>
                </div>
                <span id="tv-status" style="font-size:12px;color:var(--text-dim);margin-top:6px;display:block"></span>
            </div>

            <!-- Progress -->
            <div id="vs-progress-section" class="vs-section" style="display:none">
                <div class="vs-section-title">Training progress</div>
                <div class="vs-progress-header">
                    <span id="vs-step-label">—</span>
                    <span id="vs-pct-label" style="color:var(--text-dim);font-size:12px">0%</span>
                </div>
                <div class="vs-progress-track">
                    <div class="vs-progress-fill" id="vs-progress-fill" style="width:0%"></div>
                </div>
                <div class="vs-time-row">
                    <span id="vs-elapsed-label" class="vs-time-chip">Elapsed: —</span>
                    <span id="vs-eta-label" class="vs-time-chip">ETA: —</span>
                </div>
                <div id="vs-detail-label" class="vs-detail"></div>
                <div class="cp-widget" style="margin-top:14px;max-height:280px;overflow-y:auto">
                    <div class="cp-widget-header">
                        <span class="cp-widget-title">Training log</span>
                        <span class="cp-widget-badge" id="vs-log-badge">—</span>
                    </div>
                    <div class="log-body" id="vs-log-lines" style="max-height:220px;overflow-y:auto"></div>
                </div>
            </div>

        </div>

        <div id="tab-overview" class="cp-tab">
        <div id="cp-grid-wrap">
            <link rel="stylesheet" href="/css/gridstack.min.css" />
            <link rel="stylesheet" href="/css/gridstack-extra.min.css" />
            <script src="/js/gridstack-all.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>

            <div class="grid-stack">

                <!-- Log viewer -->
                <div class="grid-stack-item" gs-x="0" gs-y="0" gs-w="8" gs-h="10">
                    <div class="grid-stack-item-content cp-widget" id="widget-log">
                        <div class="cp-widget-header">
                            <span class="cp-widget-title">ARI.log</span>
                            <div style="display:flex;align-items:center;gap:8px">
                                <span class="cp-scroll-hint" id="log-scroll-hint">▼ new lines</span>
                                <span class="cp-widget-badge" id="log-status">connecting…</span>
                            </div>
                        </div>
                        <div class="cp-widget-body log-body" id="log-lines"></div>
                    </div>
                </div>

                <!-- Token usage per call -->
                <div class="grid-stack-item" gs-x="8" gs-y="0" gs-w="8" gs-h="6">
                    <div class="grid-stack-item-content cp-widget" id="widget-tokens">
                        <div class="cp-widget-header">
                            <span class="cp-widget-title">Token usage per call</span>
                        </div>
                        <div class="cp-widget-body" style="padding:0;overflow-y:auto">
                            <div id="live-calls-section"></div>
                            <div id="token-rows" style="padding:8px 14px 12px">
                                <div class="cp-placeholder">Waiting for data…</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- RAM line chart -->
                <div class="grid-stack-item" gs-x="8" gs-y="6" gs-w="4" gs-h="4">
                    <div class="grid-stack-item-content cp-widget" id="widget-ram">
                        <div class="cp-widget-header">
                            <span class="cp-widget-title">RAM</span>
                            <span class="cp-widget-badge" id="ram-badge">—</span>
                        </div>
                        <div class="cp-widget-body cp-chart-body">
                            <canvas id="ram-chart"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Context usage -->
                <div class="grid-stack-item" gs-x="12" gs-y="6" gs-w="4" gs-h="4">
                    <div class="grid-stack-item-content cp-widget" id="widget-context">
                        <div class="cp-widget-header">
                            <span class="cp-widget-title">Threads</span>
                        </div>
                        <div class="cp-widget-body" id="context-rows">
                            <div class="cp-placeholder">No active threads</div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        </div><!-- /tab-overview -->

    </div>
</div>

@section Styles {
<style>

/* ── sidebar extras ───────────────────────────────────── */
#btn-back {
    display: flex; align-items: center; gap: 9px;
    margin: 0 10px 14px;
    padding: 9px 12px;
    border: 1px solid rgba(255,255,255,.15);
    background: none; color: var(--sidebar-text);
    cursor: pointer; border-radius: 8px;
    font-size: 14px; font-family: inherit;
    text-decoration: none;
    transition: background .12s, border-color .12s;
    width: calc(100% - 20px);
}
#btn-back:hover { background: var(--sidebar-hover); border-color: rgba(255,255,255,.25); }
#btn-back svg { flex-shrink: 0; opacity: .7; }

#cp-sidebar-nav { padding: 0 8px; }
.cp-nav-item {
    padding: 9px 12px; border-radius: 7px;
    font-size: 14px; color: var(--sidebar-text); cursor: pointer;
    transition: background .1s;
}
.cp-nav-item:hover  { background: var(--sidebar-hover); }
.cp-nav-item.active { background: var(--sidebar-active); color: #fff; }

/* ── main ─────────────────────────────────────────────── */
#main.cp-main { flex-direction: column; }

#cp-header {
    display: flex; align-items: center; gap: 14px;
    padding: 0 24px; height: 68px; flex-shrink: 0;
    border-bottom: 1px solid var(--border);
}
#cp-logo  { width: 110px; height: auto; display: block; flex-shrink: 0; }
#cp-title { font-size: 14px; font-weight: 600; color: var(--text-dim); letter-spacing: .01em; }

/* ── grid wrap ────────────────────────────────────────── */
#cp-grid-wrap {
    flex: 1; overflow: hidden; min-height: 0;
    padding: 8px 16px 12px;
}

/* ── widgets ──────────────────────────────────────────── */
.cp-widget {
    display: flex; flex-direction: column;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden; height: 100%;
    box-shadow: 0 1px 4px rgba(0,0,0,.05);
}

.cp-widget-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 11px 14px 10px;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
}

.cp-widget-title {
    font-size: 12px; font-weight: 700;
    letter-spacing: .06em; text-transform: uppercase; color: var(--text-dim);
}

.cp-widget-badge {
    font-size: 11px; color: var(--text-dim);
    background: var(--user-bubble); border-radius: 20px; padding: 2px 8px;
}
.cp-widget-badge.live { color: #16a34a; background: #dcfce7; }

.cp-widget-body {
    flex: 1; overflow-y: auto; overflow-x: hidden;
    padding: 10px 14px;
    scrollbar-width: thin; scrollbar-color: #d1d5db transparent;
    font-size: 13px;
}

/* ── log ──────────────────────────────────────────────── */
.log-body {
    font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
    font-size: 11.5px; line-height: 1.65; color: #374151;
    padding: 10px 12px;
    display: flex; flex-direction: column; gap: 0;
}
.log-line           { white-space: pre-wrap; word-break: break-all; }
.log-line.log-warn  { color: #b45309; }
.log-line.log-error { color: #dc2626; }
.log-line.log-info  { color: #374151; }

.cp-scroll-hint {
    font-size: 11px; color: #16a34a;
    animation: hint-pulse 1.4s ease-in-out infinite;
    display: none;
}
.cp-scroll-hint.visible { display: inline; }
@@keyframes hint-pulse { 0%,100%{opacity:.4} 50%{opacity:1} }

/* ── token rows ───────────────────────────────────────── */
#token-rows { display: flex; flex-direction: column; gap: 12px; padding: 12px 14px; }

.token-row       { display: flex; flex-direction: column; gap: 3px; }
.token-row-head  { display: flex; align-items: center; gap: 6px; margin-bottom: 2px; }
.token-row-agent { font-size: 10px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
                   color: #fff; border-radius: 4px; padding: 1px 5px; flex-shrink: 0; }
.token-row-time  { color: var(--text-dim); font-size: 11px; }

.token-half      { display: flex; align-items: center; gap: 7px; }
.token-half-label { font-size: 10px; color: var(--text-dim); width: 14px; flex-shrink: 0; text-align: center; }
.token-half-bar  { flex: 1; height: 5px; border-radius: 99px; background: var(--user-bubble); overflow: hidden; display: flex; }
.token-half-fill { height: 100%; border-radius: 0; transition: width .4s ease; flex-shrink: 0; }
.token-half-val  { font-size: 11px; font-weight: 600; color: var(--text); white-space: nowrap; flex-shrink: 0; min-width: 80px; text-align: right; }

/* ── RAM chart ────────────────────────────────────────── */
.cp-chart-body { padding: 8px 10px 6px; display: flex; align-items: stretch; }
.cp-chart-body canvas { width: 100% !important; height: 100% !important; }

/* ── thread rows ──────────────────────────────────────── */
#context-rows { display: flex; flex-direction: column; gap: 12px; padding: 12px 14px; }

.thread-row { display: flex; flex-direction: column; gap: 5px; }

.thread-row-head {
    display: flex; align-items: center; gap: 7px;
}
.thread-row-key {
    font-size: 11px; color: var(--text-dim);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    flex: 1; min-width: 0;
}

.thread-bar-wrap {
    display: flex; align-items: center; gap: 8px;
}
.thread-bar-bg {
    flex: 1; height: 7px; border-radius: 4px;
    background: #e5e7eb; overflow: hidden;
}
.thread-bar-fill {
    height: 100%; border-radius: 4px;
    transition: width .6s ease, background .3s;
}
.thread-bar-label {
    font-size: 11px; color: var(--text-dim);
    white-space: nowrap; flex-shrink: 0;
}

/* ── live call indicator ──────────────────────────────── */
.live-dot {
    display: inline-block; width: 7px; height: 7px; border-radius: 50%;
    background: #16a34a; flex-shrink: 0;
    animation: live-pulse 1s ease-in-out infinite;
}
@@keyframes live-pulse { 0%,100%{opacity:.35;transform:scale(.85)} 50%{opacity:1;transform:scale(1)} }

.vision-indeterminate {
    width: 35%;
    animation: indeterminate-slide 1.4s ease-in-out infinite;
}
@@keyframes indeterminate-slide {
    0%   { transform: translateX(-100%); }
    100% { transform: translateX(400%); }
}

#live-calls-section {
    display: flex; flex-direction: column; gap: 12px;
    padding: 10px 14px 8px;
    border-bottom: 1px dashed var(--border);
    margin-bottom: 4px;
}
#live-calls-section:empty { display: none; }

/* ── placeholder ──────────────────────────────────────── */
.cp-placeholder { color: var(--text-dim); font-size: 13px; padding: 6px 0; font-style: italic; }

/* ── tab switching ────────────────────────────────────── */
.cp-tab { display: flex; flex-direction: column; }

/* ── voice synthesis tab ─────────────────────────────── */
.vs-section {
    background: #fff; border: 1px solid var(--border);
    border-radius: 12px; padding: 20px 22px; margin-bottom: 16px;
    box-shadow: 0 1px 4px rgba(0,0,0,.04);
}
.vs-section-title {
    font-size: 11px; font-weight: 700; letter-spacing: .06em;
    text-transform: uppercase; color: var(--text-dim); margin-bottom: 16px;
}
.vs-dropzone {
    border: 2px dashed var(--border); border-radius: 10px;
    padding: 32px 20px; text-align: center; cursor: pointer;
    transition: border-color .15s, background .15s;
    display: flex; flex-direction: column; align-items: center; gap: 10px;
}
.vs-dropzone:hover, .vs-dropzone.drag-over { border-color: #518c9a; background: rgba(81,140,154,.04); }
.vs-dropzone p { margin: 0; font-size: 14px; color: var(--text-dim); line-height: 1.5; }
.vs-file-list-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; font-size: 13px; }
.vs-file-item {
    display: flex; align-items: center; gap: 10px; padding: 7px 10px;
    border-radius: 7px; font-size: 12px; color: var(--text-dim);
    border: 1px solid var(--border); margin-bottom: 6px;
}
.vs-file-name { flex: 1; font-weight: 500; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.vs-file-size { flex-shrink: 0; font-size: 11px; }
.vs-form-grid { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 14px; margin-bottom: 18px; }
@@media (max-width: 900px) { .vs-form-grid { grid-template-columns: 1fr 1fr; } }
.vs-label { font-size: 12px; color: var(--text-dim); display: flex; flex-direction: column; gap: 5px; }
.vs-input {
    font-family: inherit; font-size: 13px; color: var(--text);
    background: #f9fafb; border: 1px solid var(--border);
    border-radius: 7px; padding: 8px 10px; outline: none; transition: border-color .12s;
}
.vs-input:focus { border-color: #518c9a; background: #fff; }
.vs-btn-primary {
    background: #223742; color: #fff; border: none; border-radius: 8px;
    padding: 9px 22px; font-size: 13px; font-weight: 600; font-family: inherit;
    cursor: pointer; transition: background .12s;
}
.vs-btn-primary:hover:not(:disabled) { background: #2d4a58; }
.vs-btn-primary:disabled { background: #9ca3af; cursor: not-allowed; }
.vs-btn-outline {
    background: none; border: 1px solid var(--border); color: var(--text-dim);
    border-radius: 7px; padding: 7px 16px; font-size: 12px; font-family: inherit; cursor: pointer;
}
.vs-btn-outline:hover { border-color: #518c9a; color: var(--text); }
.vs-btn-text { background: none; border: none; color: #518c9a; font-size: 12px; font-family: inherit; cursor: pointer; padding: 0; }
.vs-btn-text:hover { text-decoration: underline; }
.vs-progress-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; font-size: 13px; font-weight: 600; }
.vs-progress-track { height: 8px; border-radius: 99px; background: #e5e7eb; overflow: hidden; margin-bottom: 8px; }
.vs-progress-fill { height: 100%; border-radius: 99px; background: #518c9a; transition: width .4s ease; }
.vs-progress-fill.done  { background: #16a34a; }
.vs-progress-fill.error { background: #dc2626; }
.vs-toggle-label { display:flex; align-items:center; gap:5px; font-size:11px; color:var(--text-dim); cursor:pointer; }
.vs-toggle-label input[type=checkbox] { accent-color: #dc2626; width:13px; height:13px; cursor:pointer; }
.vs-time-row { display: flex; gap: 10px; margin-bottom: 8px; }
.vs-time-chip { font-size: 11px; color: var(--text-dim); background: #f3f4f6; border-radius: 20px; padding: 2px 10px; }
.vs-detail { font-size: 12px; color: var(--text-dim); min-height: 16px; }
.vs-separator { border: none; border-top: 1px solid var(--border); margin: 4px 0 16px; }

</style>
}

@section Scripts {
<script>

// ── tab switching ────────────────────────────────────────
const cpTitle  = document.getElementById('cp-title');
const navItems = document.querySelectorAll('.cp-nav-item[data-tab]');
const tabs     = { overview: document.getElementById('tab-overview'), voice: document.getElementById('tab-voice') };

function switchTab(name) {
    navItems.forEach(n => n.classList.toggle('active', n.dataset.tab === name));
    Object.entries(tabs).forEach(([k, el]) => { if (el) el.style.display = k === name ? '' : 'none'; });
    cpTitle.textContent = name === 'voice' ? 'Voice Synthesis' : 'Overview';
    // Hide gridwrap padding when not on overview
    const gw = document.getElementById('cp-grid-wrap');
    if (gw) gw.style.display = name === 'overview' ? '' : 'none';
}

navItems.forEach(n => n.addEventListener('click', () => switchTab(n.dataset.tab)));
// Initial state: grid is inside tab-overview so it shows by default
switchTab('overview');

// ── sidebar toggle ───────────────────────────────────────
const sidebar  = document.getElementById('sidebar');
const floatBtn = document.getElementById('topbar-toggle');
const overlay  = document.getElementById('sidebar-overlay');
const isMobile = () => window.innerWidth <= 640;

function setSidebarCollapsed(collapsed) {
    if (isMobile()) {
        sidebar.classList.toggle('mobile-open', !collapsed);
        overlay.classList.toggle('visible', !collapsed);
        floatBtn.classList.toggle('visible', collapsed);
    } else {
        sidebar.classList.remove('mobile-open');
        overlay.classList.remove('visible');
        sidebar.classList.toggle('collapsed', collapsed);
        floatBtn.classList.toggle('visible', collapsed);
    }
}

overlay.addEventListener('click', () => setSidebarCollapsed(true));
document.getElementById('btn-toggle-sidebar').addEventListener('click', () => setSidebarCollapsed(true));
floatBtn.addEventListener('click', () => setSidebarCollapsed(false));

// ── gridstack ────────────────────────────────────────────
const LAYOUT_KEY  = 'ari-cp-layout-v2';
const COLS        = 16;
const ROWS        = 10;
const MARGIN      = 8;

// Default positions used on first load or when saved layout is cleared
const DEFAULT_LAYOUT = [
    { id: 'widget-log',     x: 0,  y: 0, w: 8, h: 10 },
    { id: 'widget-tokens',  x: 8,  y: 0, w: 8, h: 6  },
    { id: 'widget-ram',     x: 8,  y: 6, w: 4, h: 4  },
    { id: 'widget-context', x: 12, y: 6, w: 4, h: 4  },
];

let savedLayout = null;
try { savedLayout = JSON.parse(localStorage.getItem(LAYOUT_KEY)); } catch {}

const gridWrap = document.getElementById('cp-grid-wrap');

function calcCellHeight() {
    const h = gridWrap.clientHeight;
    return Math.max(60, Math.floor((h - MARGIN * (ROWS + 1)) / ROWS));
}

const grid = GridStack.init({
    column:   COLS,
    maxRow:   ROWS,
    float:    false,
    margin:   MARGIN,
    cellHeight: calcCellHeight(),
    animate:  false,
});

// Restore saved layout (positions/sizes only, not content)
if (savedLayout && savedLayout.length) {
    grid.load(savedLayout, false);
} else {
    grid.load(DEFAULT_LAYOUT, false);
}

// Persist on any drag/resize change
grid.on('change', () => {
    localStorage.setItem(LAYOUT_KEY, JSON.stringify(grid.save(false)));
});

// Refit cell height on resize — items stay the same size and reflow naturally
let resizeTimer;
window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => grid.cellHeight(calcCellHeight()), 80);
});

// ── log SSE ──────────────────────────────────────────────
const logLines    = document.getElementById('log-lines');
const logStatus   = document.getElementById('log-status');
const scrollHint  = document.getElementById('log-scroll-hint');
const MAX_LOG_LINES = 300;

// Track whether the user has scrolled up; if so, don't auto-scroll.
let logUserScrolled = false;
logLines.addEventListener('scroll', () => {
    const atBottom = logLines.scrollHeight - logLines.scrollTop - logLines.clientHeight < 40;
    if (atBottom) {
        logUserScrolled = false;
        scrollHint.classList.remove('visible');
    } else {
        logUserScrolled = true;
    }
});

function classifyLog(line) {
    const l = line.toLowerCase();
    if (l.includes('[err') || l.includes('error') || l.includes('fatal')) return 'log-error';
    if (l.includes('[wrn') || l.includes('warn'))  return 'log-warn';
    return 'log-info';
}

function appendLogLine(text) {
    const el = document.createElement('div');
    el.className = 'log-line ' + classifyLog(text);
    el.textContent = text;
    logLines.appendChild(el);
    while (logLines.children.length > MAX_LOG_LINES)
        logLines.removeChild(logLines.firstChild);

    if (!logUserScrolled) {
        logLines.scrollTop = logLines.scrollHeight;
    } else {
        scrollHint.classList.add('visible');
    }
}

(function connectLog() {
    const es = new EventSource('/api/cp/log');
    es.onopen    = () => { logStatus.textContent = 'live'; logStatus.classList.add('live'); };
    es.onerror   = () => { logStatus.textContent = 'reconnecting…'; logStatus.classList.remove('live'); setTimeout(connectLog, 3000); es.close(); };
    es.onmessage = e  => appendLogLine(e.data.replace(/↵/g, '\n'));
})();


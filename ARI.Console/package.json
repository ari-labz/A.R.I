{
  "name": "ari-console",
  "version": "0.1.5",
  "description": "A·R·I Server console — runs and monitors the local server, stops it when closed.",
  "author": "Xywren",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "ai.ari.server",
    "productName": "A.R.I",
    "icon": "assets/icon.png",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "assets/**/*"],
    "afterPack": "./afterPack.js",
    "mac":   { "target": "zip", "icon": "assets/icon.icns", "identity": null, "artifactName": "ARIConsole-mac.${ext}" },
    "win":   { "target": "zip", "artifactName": "ARIConsole-win.${ext}" },
    "linux": { "target": "zip", "artifactName": "ARIConsole-linux.${ext}" }
  }
}

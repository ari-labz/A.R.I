<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-ARI.Discord-6b8bd750-83c4-4213-b772-0e8767194a7b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.20.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ARI.LLM\ARI.LLM.csproj" />
    <ProjectReference Include="..\ARI.Common\ARI.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Scripts\" />
  </ItemGroup>

  <!-- Discord.Net voice requires libopus, libsodium, and libdave (E2EE/DAVE protocol) as native deps. -->
  <Target Name="CopyVoiceNativeLibs" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Copy SourceFiles="/opt/homebrew/lib/libopus.dylib"   DestinationFiles="$(OutputPath)runtimes/osx-arm64/native/libopus.dylib"   SkipUnchangedFiles="true" />
    <Copy SourceFiles="/opt/homebrew/lib/libsodium.dylib" DestinationFiles="$(OutputPath)runtimes/osx-arm64/native/libsodium.dylib" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../devbuild/runtimes/osx-arm64/native/libdave.dylib" DestinationFiles="$(OutputPath)runtimes/osx-arm64/native/libdave.dylib" SkipUnchangedFiles="true" />
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-ARI.Discord-6b8bd750-83c4-4213-b772-0e8767194a7b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.20.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="libsodium" Version="1.0.22" />
    <PackageReference Include="OpusSharp.Natives" Version="1.6.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ARI.LLM\ARI.LLM.csproj" />
    <ProjectReference Include="..\ARI.Common\ARI.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Scripts\" />
  </ItemGroup>

  <!-- libdave (Discord E2EE/DAVE protocol) is the only native dep not available via NuGet. -->
  <Target Name="CopyVoiceNativeLibs" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../devbuild/runtimes/osx-arm64/native/libdave.dylib" DestinationFiles="$(OutputPath)runtimes/osx-arm64/native/libdave.dylib" SkipUnchangedFiles="true" />
  </Target>
</Project>

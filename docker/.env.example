# Copy to .env next to docker-compose.yml (or paste into Portainer's "Environment variables").
# Every value has a default, so an empty file works too.

# Image tag: "latest" follows new releases; pin one (e.g. 0.8.3) to hold back updates.
ARI_TAG=latest

# Where the web UI is served on this machine: http://<machine>:5074
ARI_PORT=5074

# Where A·R·I's data lives. Default is a Docker volume; set a path to keep it in a folder you control.
# ARI_DATA=/srv/ari

# Host user that should own the data folder when ARI_DATA is a path (find yours with `id`).
# PUID=1000
# PGID=1000

TZ=Europe/London

# How often (seconds) the update service checks for a newer image.
UPDATE_INTERVAL_SECONDS=3600

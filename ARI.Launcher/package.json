{
  "name": "ari-launcher",
  "version": "1.0.0",
  "description": "ARI Launcher",
  "author": "Xywren",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "ai.ari.launcher",
    "productName": "ARI",
    "icon": "assets/icon.png",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "assets/**/*"],
    "mac":   { "target": "zip", "icon": "assets/icon.icns", "artifactName": "ARILauncher-mac.${ext}" },
    "win":   { "target": "zip", "artifactName": "ARILauncher-win.${ext}" },
    "linux": { "target": "zip", "artifactName": "ARILauncher-linux.${ext}" }
  }
}
